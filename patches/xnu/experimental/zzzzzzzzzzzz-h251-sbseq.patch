+/* H251: burst helpers.  quiet keeps the ring log readable at 20 Hz, and the
+ * trace dump prints the ordered sequence as run-length pairs so a thread that
+ * advances through new code looks different from one that spins on a stub. */
+void
+native_sb_set_quiet(int on)
+{
+	native_sb_quiet = on;
+}
+
+void
+native_sb_trace_start(void)
+{
+	native_sb_seq_n = 0;
+	native_sb_seq_on = 1;
+}
+
+void
+native_sb_trace_dump(unsigned burst)
+{
+	uint64_t tids[16];
+	unsigned nt = 0;
+
+	native_sb_seq_on = 0;
+	for (unsigned i = 0; i < native_sb_seq_n; i++) {
+		unsigned j;
+		for (j = 0; j < nt; j++) {
+			if (tids[j] == native_sb_seq[i].tid) {
+				break;
+			}
+		}
+		if (j == nt && nt < 16) {
+			tids[nt++] = native_sb_seq[i].tid;
+		}
+	}
+	printf("NATIVE_SBSEQ: burst=%u entries=%u tids=%u\n", burst, native_sb_seq_n, nt);
+	for (unsigned t = 0; t < nt; t++) {
+		uint64_t last = 0;
+		unsigned run = 0, runs = 0, total = 0, shown = 0, off = 0;
+		char line[192];
+
+		line[0] = 0;
+		for (unsigned i = 0; i <= native_sb_seq_n; i++) {
+			if (i < native_sb_seq_n) {
+				if (native_sb_seq[i].tid != tids[t]) {
+					continue;
+				}
+				total++;
+				if (run != 0 && native_sb_seq[i].pc == last) {
+					run++;
+					continue;
+				}
+			}
+			if (run != 0) {
+				if (shown < 10 && off + 40 < sizeof line) {
+					off += (unsigned)snprintf(line + off, sizeof line - off,
+					    "%s%llx*%u", shown ? "," : "",
+					    (unsigned long long)last, run);
+					shown++;
+				}
+				runs++;
+			}
+			if (i < native_sb_seq_n) {
+				last = native_sb_seq[i].pc;
+				run = 1;
+			}
+		}
+		printf("NATIVE_SBSEQ: burst=%u tid=%llu n=%u runs=%u seq=%s%s\n",
+		    burst, (unsigned long long)tids[t], total, runs, line,
+		    (runs > shown) ? ",..." : "");
+	}
+}
