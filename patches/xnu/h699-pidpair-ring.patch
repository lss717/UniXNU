+/* H699: bidirectional ring keyed by process GENERATIONS. STATUS 400-403
+ * narrowed the fork to one question: after backboardd's kernel hand-off of
+ * the 0x9d0a registrations, does the server ever SEND the MIG reply back?
+ * The bound ring watches one port only, the BKS ring only the SB<->launchd
+ * pair, the generic IPC ring is written but never printed. This ring keeps
+ * EVERY ipc-layer event between the SpringBoard / backboardd / PosterBoard
+ * generations - all ids, all sizes, replies not assumed - and logs the
+ * header port names purely as correlation hints (never dereferenced, never
+ * compared across tasks). Lock-free writer, no printing on the hot path. */
+#define NATIVE_PAIR_RING 256
+struct native_pair_event {
+	uint64_t serial;
+	uint64_t port;
+	uint64_t tid;
+	uint32_t ms;
+	uint32_t id;
+	uint32_t size;
+	uint32_t local_name;
+	uint32_t remote_name;
+	int32_t from;
+	int32_t to;
+	uint32_t kind;
+	uint32_t result;
+};
+static struct native_pair_event native_pair_events[NATIVE_PAIR_RING];
+static unsigned native_pair_written;
+static unsigned native_pair_lost;
+static int native_pair_sb[4];
+static int native_pair_bb[4];
+static int native_pair_pb[4];
+static unsigned native_pair_sb_n;
+static unsigned native_pair_bb_n;
+static unsigned native_pair_pb_n;
+
+static void
+native_pair_gen_push(int pid, int *list, unsigned *count)
+{
+	unsigned i;
+
+	for (i = 0; i < *count; i++) {
+		if (list[i] == pid) {
+			return;
+		}
+	}
+	if (*count < 4) {
+		list[(*count)++] = pid;
+	}
+}
+
+static void
+native_pair_gen_note(int pid, const char *comm)
+{
+	if (comm == NULL || pid <= 0) {
+		return;
+	}
+	if (strcmp(comm, "SpringBoard") == 0) {
+		native_pair_gen_push(pid, native_pair_sb, &native_pair_sb_n);
+	} else if (strcmp(comm, "backboardd") == 0) {
+		native_pair_gen_push(pid, native_pair_bb, &native_pair_bb_n);
+	} else if (strcmp(comm, "PosterBoard") == 0) {
+		native_pair_gen_push(pid, native_pair_pb, &native_pair_pb_n);
+	}
+}
+
+static bool
+native_pair_member(int pid)
+{
+	unsigned i;
+
+	if (pid <= 1) {
+		return false;
+	}
+	for (i = 0; i < native_pair_sb_n; i++) {
+		if (native_pair_sb[i] == pid) {
+			return true;
+		}
+	}
+	for (i = 0; i < native_pair_bb_n; i++) {
+		if (native_pair_bb[i] == pid) {
+			return true;
+		}
+	}
+	for (i = 0; i < native_pair_pb_n; i++) {
+		if (native_pair_pb[i] == pid) {
+			return true;
+		}
+	}
+	return false;
 }
 
+static void
+native_pair_note(unsigned kind, ipc_kmsg_t kmsg, ipc_port_t port,
+    int from_pid, int to_pid, uint64_t receiver_tid, unsigned result)
+{
+	mach_msg_header_t *hdr;
+	struct native_pair_event *e;
+	unsigned w;
+
+	if (from_pid == to_pid || !native_pair_member(from_pid) ||
+	    !native_pair_member(to_pid)) {
+		return;
+	}
+	w = __atomic_fetch_add(&native_pair_written, 1, __ATOMIC_RELAXED);
+	if (w >= NATIVE_PAIR_RING) {
+		__atomic_fetch_add(&native_pair_lost, 1, __ATOMIC_RELAXED);
+		return;
+	}
+	hdr = kmsg ? ikm_header(kmsg) : NULL;
+	e = &native_pair_events[w];
+	e->serial = w + 1;
+	e->port = (uint64_t)(uintptr_t)port;
+	e->tid = receiver_tid;
+	e->ms = (uint32_t) (mach_absolute_time() / 19200ULL);
+	e->id = hdr ? (uint32_t) hdr->msgh_id : 0;
+	e->size = hdr ? (uint32_t) hdr->msgh_size : 0;
+	e->local_name = hdr ? (uint32_t) hdr->msgh_local_port : 0;
+	e->remote_name = hdr ? (uint32_t) hdr->msgh_remote_port : 0;
+	e->from = from_pid;
+	e->to = to_pid;
+	e->kind = kind;
+	e->result = result;
+}
+
 void
+native_pairport_export(void)
+{
+	static unsigned native_pair_cur;
+	extern void native_log_flush_hook(void);
+	unsigned total = native_pair_written;
+	unsigned emitted = 0;
+
+	if (total > NATIVE_PAIR_RING) {
+		total = NATIVE_PAIR_RING;
+	}
+	printf("NATIVE_PAIR_GEN: sb=%d/%d/%d/%d bb=%d/%d/%d/%d pb=%d/%d/%d/%d "
+	    "written=%u lost=%u\n",
+	    native_pair_sb[0], native_pair_sb[1], native_pair_sb[2], native_pair_sb[3],
+	    native_pair_bb[0], native_pair_bb[1], native_pair_bb[2], native_pair_bb[3],
+	    native_pair_pb[0], native_pair_pb[1], native_pair_pb[2], native_pair_pb[3],
+	    native_pair_written, native_pair_lost);
+	while (native_pair_cur < total && emitted < 16) {
+		struct native_pair_event *e = &native_pair_events[native_pair_cur];
+		printf("NATIVE_PAIR_EVT: serial=%llu kind=%c ms=%u id=0x%x size=%u "
+		    "from=%d to=%d port=0x%llx ln=0x%x rn=0x%x tid=%llu result=0x%x\n",
+		    (unsigned long long) e->serial, (int) e->kind, e->ms, e->id, e->size,
+		    e->from, e->to, (unsigned long long) e->port, e->local_name,
+		    e->remote_name, (unsigned long long) e->tid, e->result);
+		native_pair_cur++;
+		emitted++;
+		if ((emitted % 4) == 0) {
+			native_log_flush_hook();
+			IOSleep(800);
+		}
+	}
+	native_log_flush_hook();
+	IOSleep(300);
+}
