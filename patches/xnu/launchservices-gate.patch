diff --git a/bsd/vfs/vfs_vnops.c b/bsd/vfs/vfs_vnops.c
--- a/bsd/vfs/vfs_vnops.c
+++ b/bsd/vfs/vfs_vnops.c
@@ -78,3 +78,57 @@
 #include <sys/file_internal.h>
 #include <mach/mach_time.h>
+#define NATIVE_LSD_TRACK_SLOTS 8
+
+struct native_lsd_track_slot {
+	uint32_t active;
+	char path[160];
+};
+
+static struct native_lsd_track_slot gNativeLsdSlots[NATIVE_LSD_TRACK_SLOTS];
+static uint32_t gNativeLsdNextSlot;
+static uint32_t gNativeLsdActive;
+static uint32_t gNativeLsdOpens;
+static uint32_t gNativeLsdSlow;
+static uint64_t gNativeLsdMaxNs;
+
+void native_lsd_gate(uint32_t sample);
+
+static void
+native_lsd_account(uint64_t ns)
+{
+	__atomic_add_fetch(&gNativeLsdOpens, 1, __ATOMIC_RELAXED);
+	uint64_t max_ns = __atomic_load_n(&gNativeLsdMaxNs, __ATOMIC_RELAXED);
+	while (ns > max_ns &&
+	    !__atomic_compare_exchange_n(&gNativeLsdMaxNs, &max_ns, ns, 0,
+	    __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+	}
+	if (ns >= 50000000ULL) {
+		__atomic_add_fetch(&gNativeLsdSlow, 1, __ATOMIC_RELAXED);
+	}
+}
+
+static void
+native_lsd_end(uint32_t slot)
+{
+	__atomic_store_n(&gNativeLsdSlots[slot].active, 0, __ATOMIC_RELEASE);
+	__atomic_sub_fetch(&gNativeLsdActive, 1, __ATOMIC_RELAXED);
+}
+
+void
+native_lsd_gate(uint32_t sample)
+{
+	printf("NATIVE_LS_GATE: sample=%u opens=%u active=%u slow=%u max_ms=%llu\n",
+	    sample, __atomic_load_n(&gNativeLsdOpens, __ATOMIC_RELAXED),
+	    __atomic_load_n(&gNativeLsdActive, __ATOMIC_RELAXED),
+	    __atomic_load_n(&gNativeLsdSlow, __ATOMIC_RELAXED),
+	    __atomic_load_n(&gNativeLsdMaxNs, __ATOMIC_RELAXED) / 1000000ULL);
+	for (uint32_t i = 0; i < NATIVE_LSD_TRACK_SLOTS; i++) {
+		uint32_t active = __atomic_load_n(&gNativeLsdSlots[i].active,
+		    __ATOMIC_ACQUIRE);
+		if (gNativeLsdSlots[i].path[0] != '\0') {
+			printf("NATIVE_LS_GATE_SLOT: sample=%u slot=%u active=%u path=%s\n",
+			    sample, i, active, gNativeLsdSlots[i].path);
+		}
+	}
+}
 #include <sys/stat.h>
@@ -184,15 +229,23 @@ vn_open_modflags(struct nameidata *ndp, int *fmodep, int cmode)
 	boolean_t native_lsd = current_proc() != PROC_NULL &&
 	    strncmp(current_proc()->p_comm, "lsd", MAXCOMLEN) == 0;
 	uint64_t native_lsd_start = 0;
 	char native_lsd_path[160];
+	uint32_t native_lsd_slot_index = 0;
 	if (native_lsd) {
 		size_t native_lsd_len = 0;
 		native_lsd_start = mach_absolute_time();
 		native_lsd_path[0] = '\0';
+		__atomic_add_fetch(&gNativeLsdActive, 1, __ATOMIC_RELAXED);
 		if (copyinstr(ndp->ni_dirp, native_lsd_path,
 		    sizeof native_lsd_path, &native_lsd_len) != 0) {
 			strlcpy(native_lsd_path, "<copy-failed>", sizeof native_lsd_path);
 		}
+		native_lsd_slot_index = __atomic_add_fetch(&gNativeLsdNextSlot, 1,
+		    __ATOMIC_RELAXED) & (NATIVE_LSD_TRACK_SLOTS - 1);
+		strlcpy(gNativeLsdSlots[native_lsd_slot_index].path, native_lsd_path,
+		    sizeof gNativeLsdSlots[native_lsd_slot_index].path);
+		__atomic_store_n(&gNativeLsdSlots[native_lsd_slot_index].active, 1,
+		    __ATOMIC_RELEASE);
 	}
 	int error;
 	struct vnode_attr *vap;
@@ -225,3 +278,4 @@ vn_open_modflags(struct nameidata *ndp, int *fmodep, int cmode)
 		uint32_t native_lsd_n = __atomic_add_fetch(&native_lsd_opens, 1, __ATOMIC_RELAXED);
 		absolutetime_to_nanoseconds(mach_absolute_time() - native_lsd_start, &native_lsd_ns);
+		native_lsd_account(native_lsd_ns);
 		if (native_lsd_ns > __atomic_load_n(&native_lsd_max_ns, __ATOMIC_RELAXED)) {
@@ -240,4 +294,5 @@ vn_open_modflags(struct nameidata *ndp, int *fmodep, int cmode)
 		    native_lsd_n, __atomic_load_n(&native_lsd_slow, __ATOMIC_RELAXED),
 		    __atomic_load_n(&native_lsd_max_ns, __ATOMIC_RELAXED) / 1000000ULL);
+		native_lsd_end(native_lsd_slot_index);
 	}
 	return error;
 }
