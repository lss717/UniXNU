+/* H350: user stack frames for the sampled process (fp chain through copyinmap). */
+#include <kern/circle_queue.h>
+extern kern_return_t copyinmap(vm_map_t map, user_addr_t uaddr, void *kaddr, vm_size_t len);
+extern vm_map_t get_task_map(task_t task);
