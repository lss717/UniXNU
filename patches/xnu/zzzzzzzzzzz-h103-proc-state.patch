+/* H124: exported so the UFS driver can print it only at the later stages;
+ * the +2 s snapshot already proved the send-block there is transient. */
+void
+native_proc_wait_graph(void)
+{
+	native_wait_row_count = 0;
+	/* PROC_ALLPROCLIST | PROC_NOWAITTRANS, same as native_proc_summary(). */
+	proc_iterate(1U | 4U, native_wait_row_collect, NULL, NULL, NULL);
+	for (unsigned i = 0; i < native_wait_row_count; i++) {
+		printf("NATIVE_WAIT: pid=%d comm=%s threads=%u run=%u sb=%u tid=%llu st=%x wait=%llx cont=%p\n",
+		    native_wait_rows[i].pid, native_wait_rows[i].comm,
+		    native_wait_rows[i].threads, native_wait_rows[i].runnable,
+		    native_wait_rows[i].sendblock,
+		    (unsigned long long)native_wait_rows[i].tid,
+		    native_wait_rows[i].state,
+		    (unsigned long long)native_wait_rows[i].wait,
+		    native_wait_rows[i].cont);
+	}
+}
