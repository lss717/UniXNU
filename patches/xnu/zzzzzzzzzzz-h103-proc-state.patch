+/* H236ij: user-PC samples of a named process, for locating a stuck userspace thread.
+ * Ten samples one second apart separate "blocked" from "spinning"; one sample would only show
+ * the mach_msg trap every healthy thread sits in.  Only TH_WAIT threads are read (kernel threads
+ * have no user state, a thread running on a CPU carries the state of its last trap), the state is
+ * validated, and the pc must look like a user address.  The thread queue is walked under
+ * task_lock_try() and nothing is printed while the lock is held (IOLog can block). */
+#include <mach/arm/thread_status.h>
+extern struct arm_saved_state *get_user_regs(thread_t);
+
+#include <ipc/ipc_port.h>
+
+#include <ipc/ipc_port.h>
+
+#include <ipc/ipc_port.h>
+
+struct native_sb_row {
+	uint64_t tid;
+	uint64_t pc;
+	uint64_t lr;
+	uint64_t wait;
+	uint64_t fp;
+	/* H237: arm64 syscall arguments from the same saved state.  A thread
+	 * blocked in mach_msg2_trap has its packed call arguments in x1..x7
+	 * (struct mach_msg2_trap_args: data/options/bits/ports/id/...), and the
+	 * trap number (47, negated) in x16, so no copyin is needed for those. */
+	uint64_t x1;
+	uint64_t x2;
+	uint64_t x3;
+	uint64_t x4;
+	uint64_t x5;
+	uint64_t x6;
+	uint64_t x7;
+	uint64_t x16;
+};
+static struct native_sb_row native_sb_rows[16];
+static unsigned native_sb_count;
+static const char *native_sb_note;
+static const char *native_sb_name;
+
+/* H239: describe the port the blocked thread is receiving from, and the port
+ * of the request still left in its message buffer.  Only scalar fields are
+ * kept; the receiver task pointer is used for pointer comparison only, so no
+ * task or proc is dereferenced while the port lock is held. */
+struct native_sb_probe {
+	int seen;
+	int is_set;
+	uint64_t ie_bits;
+	unsigned srights;
+	unsigned mscount;
+	int queued;             /* H351: messages waiting on the port */
+	unsigned rname;         /* H352: port's name in the receiver's space */
+	unsigned sorights;      /* H354: send-once rights, i.e. unconsumed replies */
+	int pid;
+	uint64_t port;          /* H242: port object, compared only */
+};
+static struct native_sb_probe native_sb_rcv;
+static struct native_sb_probe native_sb_req;
+static uint64_t native_sb_buf;
+static unsigned native_sb_rcv_name;
+static int native_sb_hdr_ok;
+static uint32_t native_sb_hdr[6];
+static int native_sb_capture;
+static int native_sb_pid;
+static task_t native_sb_task;
+
+/* H245: every thread of the sampled process, not only the blocked ones, so the
+ * offline pass can tell whether SpringBoard ever runs inside QuartzCore (L2) or
+ * Metal/AGX (L3) instead of only waiting in libsystem_kernel. */
+struct native_sb_allrow {
+	uint64_t tid;
+	uint32_t state;
+	uint64_t pc;
+	uint64_t lr;
+};
+static struct native_sb_allrow native_sb_all[24];
+static unsigned native_sb_alln;
+static uint64_t native_sb_lastpcs[12];
+static unsigned native_sb_lastn;
+
+static void
+native_sb_probe_name(ipc_space_t space, unsigned name, struct native_sb_probe *out)
+{
+	ipc_entry_t entry;
+	ipc_port_t port;
+
+	memset(out, 0, sizeof(*out));
+	out->pid = -1;
+	if (space == IS_NULL || name == MACH_PORT_NULL) {
+		return;
+	}
+	is_write_lock(space);
+	entry = ipc_entry_lookup(space, (mach_port_name_t)name);
+	if (entry != IE_NULL) {
+		out->ie_bits = (uint64_t)entry->ie_bits;
+		/* A port set's ie_object is an ipc_pset, NOT an ipc_port: passing it
+		 * to ipc_port_get_receiver_task() locks the wrong object and the
+		 * later free trips zone_require (H239 panic).  Only a real port is
+		 * probed, and only when the entry still carries a port right. */
+		out->is_set = (entry->ie_bits & MACH_PORT_TYPE_PORT_SET) != 0;
+		if (!out->is_set &&
+		    (entry->ie_bits & MACH_PORT_TYPE_PORT_OR_DEAD) != 0 &&
+		    entry->ie_object != IP_NULL) {
+			port = (ipc_port_t)entry->ie_object;
+			out->port = (uint64_t)(uintptr_t)port;
+			out->srights = port->ip_srights;
+			out->mscount = port->ip_mscount;
+			/* Takes the port queue lock itself and reports the pid of the
+			 * task that holds the receive right (safe, no hand locking). */
+			out->pid = ipc_port_get_receiver_task(port, NULL);
+			/* H351: is the request still sitting in the receiver's queue?
+			 * Read without the port lock (diagnostic only): the pointer is
+			 * either NULL or a valid kmsg, and we only test it. */
+			out->queued = circle_queue_empty(&port->ip_messages.imq_messages) ? 0 : 1;
+			out->rname = port->ip_messages.imq_receiver_name;
+			out->sorights = port->ip_sorights;
+		}
+	}
+	is_write_unlock(space);
+	out->seen = 1;
+}
+
+static int
+native_sb_collect(struct proc *p, void *arg)
+{
+	char comm[17];
+
+	(void)arg;
+	proc_name(proc_getpid(p), comm, sizeof comm);
+	if (strncmp(comm, native_sb_name, strlen(native_sb_name)) != 0) {
+		return 0;
+	}
+	native_sb_pid = proc_getpid(p);
+	struct task *t = proc_task(p);
+	if (!t) {
+		native_sb_note = "no-task";
+		return 1;
+	}
+	if (!task_lock_try(t)) {
+		native_sb_note = "locked";
+		return 1;
+	}
+	thread_t th;
+	queue_iterate(&t->threads, th, thread_t, task_threads) {
+		if ((th->state & TH_WAIT) == 0) {
+			continue;
+		}
+		arm_saved_state_t *state = get_user_regs(th);
+		if (!state || !is_saved_state64(state)) {
+			continue;
+		}
+		uint64_t pc = get_saved_state_pc(state);
+		if (pc < 0x100000000ULL || pc >= 0x8000000000ULL) {
+			continue;
+		}
+		if (native_sb_alln < sizeof(native_sb_all) / sizeof(native_sb_all[0])) {
+			native_sb_all[native_sb_alln].tid = thread_tid(th);
+			native_sb_all[native_sb_alln].state = th->state;
+			native_sb_all[native_sb_alln].pc = pc;
+			native_sb_all[native_sb_alln].lr = get_saved_state_lr(state);
+			native_sb_alln++;
+		}
+		/* Mach traps carry a NEGATIVE syscall number in x16
+		 * (osfmk/arm64/bsd_arm64.c: assert(call_number < 0) then
+		 * call_number = -call_number), so mach_msg2_trap is -47. */
+		if (native_sb_task == TASK_NULL && !native_sb_capture &&
+		    (int32_t)(uint32_t)get_saved_state_reg(state, 16) == -47) {
+			native_sb_capture = 1;
+			native_sb_buf = (uint64_t)get_saved_state_reg(state, 0);
+			native_sb_rcv_name = (unsigned)(uint32_t)
+			    (get_saved_state_reg(state, 5) >> 32);
+		}
+		if (native_sb_count < sizeof(native_sb_rows) / sizeof(native_sb_rows[0])) {
+			native_sb_rows[native_sb_count].tid = thread_tid(th);
+			native_sb_rows[native_sb_count].pc = pc;
+			native_sb_rows[native_sb_count].lr = get_saved_state_lr(state);
+			native_sb_rows[native_sb_count].wait = (uint64_t)(uintptr_t)th->wait_event;
+			native_sb_rows[native_sb_count].fp = (uint64_t)get_saved_state_reg(state, 29);
+			native_sb_rows[native_sb_count].x1 = (uint64_t)get_saved_state_reg(state, 1);
+			native_sb_rows[native_sb_count].x2 = (uint64_t)get_saved_state_reg(state, 2);
+			native_sb_rows[native_sb_count].x3 = (uint64_t)get_saved_state_reg(state, 3);
+			native_sb_rows[native_sb_count].x4 = (uint64_t)get_saved_state_reg(state, 4);
+			native_sb_rows[native_sb_count].x5 = (uint64_t)get_saved_state_reg(state, 5);
+			native_sb_rows[native_sb_count].x6 = (uint64_t)get_saved_state_reg(state, 6);
+			native_sb_rows[native_sb_count].x7 = (uint64_t)get_saved_state_reg(state, 7);
+			native_sb_rows[native_sb_count].x16 = (uint64_t)get_saved_state_reg(state, 16);
+			native_sb_count++;
+		}
+	}
+	task_unlock(t);
+	/* The proc reference keeps the task alive, so taking the task reference
+	 * after dropping task_lock is safe and cannot deadlock. */
+	if (native_sb_task == TASK_NULL) {
+		task_reference(t);
+		native_sb_task = t;
+	}
+	return 1;
+}
+
+static void native_xpc_register(uint64_t port, int pid, const char *owner, char role);
+static void native_xpc_dump(unsigned sample);
+static void native_xpc_emit(unsigned sample, unsigned budget);
+static int native_xpc_pids[3];
+static char native_xpc_names[16][48];
+static unsigned native_xpc_names_n;
+static unsigned native_xpc_names_printed;
+
+void
+native_sb_pc_sample(const char *name, unsigned sample)
+{
+	char native_sb_qname1[17];
+	char native_sb_qname2[17];
+
+	native_sb_count = 0;
+	native_sb_note = "-";
+	native_sb_name = name;
+	native_sb_capture = 0;
+	native_sb_hdr_ok = 0;
+	native_sb_buf = 0;
+	native_sb_rcv_name = 0;
+	memset(&native_sb_rcv, 0, sizeof native_sb_rcv);
+	memset(&native_sb_req, 0, sizeof native_sb_req);
+	memset(native_sb_hdr, 0, sizeof native_sb_hdr);
+	native_sb_alln = 0;
+	proc_iterate(1U | 4U, native_sb_collect, NULL, NULL, NULL);
+	if (native_sb_pid > 0) {
+		if (strncmp(name, "SpringBoard", 11) == 0) {
+			native_xpc_pids[0] = native_sb_pid;
+		} else if (strncmp(name, "lsd", 3) == 0) {
+			native_xpc_pids[1] = native_sb_pid;
+		} else if (strncmp(name, "containermanager", 16) == 0) {
+			native_xpc_pids[2] = native_sb_pid;
+		}
+	}
+	native_xpc_emit(sample, 25);
+	printf("NATIVE_SBPC: sample=%u comm=%s n=%u note=%s\n", sample, name, native_sb_count, native_sb_note);
+	for (unsigned i = 0; i < native_sb_count; i++) {
+		printf("NATIVE_SBPC: sample=%u comm=%s tid=%llu pc=0x%llx lr=0x%llx wait=0x%llx\n", sample, name,
+		    (unsigned long long)native_sb_rows[i].tid,
+		    (unsigned long long)native_sb_rows[i].pc,
+		    (unsigned long long)native_sb_rows[i].lr,
+		    (unsigned long long)native_sb_rows[i].wait);
+		int want = strncmp(name, "SpringBoard", 11) == 0 ||
+		    ((sample % 30) == 0 && i < 8);
+		if (want && native_sb_task != TASK_NULL &&
+		    native_sb_rows[i].fp != 0) {
+			uint64_t walk = native_sb_rows[i].fp;
+			for (unsigned d = 0; d < 8 && walk != 0; d++) {
+				uint64_t frame[2] = { 0, 0 };
+				if (copyinmap(get_task_map(native_sb_task), (user_addr_t)walk,
+				    frame, sizeof(frame)) != 0) {
+					break;
+				}
+				printf("NATIVE_SBFRAME: sample=%u comm=%s tid=%llu d=%u lr=0x%llx\n",
+				    sample, name, (unsigned long long)native_sb_rows[i].tid, d,
+				    (unsigned long long)frame[1]);
+				if (frame[0] <= walk) {
+					break;
+				}
+				walk = frame[0];
+			}
+		}
+	}
+	/* H237: decode the packed mach_msg2_trap arguments of any thread that is
+	 * inside that trap.  opt=options, bits/send_size, remote/local port names,
+	 * voucher port and msgh_id, desc count/rcv name, rcv size/priority. */
+	for (unsigned i = 0; i < native_sb_count; i++) {
+		uint64_t bs, rl, vi, dr, rp;
+		if ((int32_t)(uint32_t)native_sb_rows[i].x16 != -47) {
+			continue;
+		}
+		bs = native_sb_rows[i].x2;
+		rl = native_sb_rows[i].x3;
+		vi = native_sb_rows[i].x4;
+		dr = native_sb_rows[i].x5;
+		rp = native_sb_rows[i].x6;
+		printf("NATIVE_SBMSG2: sample=%u comm=%s tid=%llu opt=0x%llx bits=0x%x ssz=%u rport=0x%x lport=0x%x vport=0x%x id=0x%x rcvname=0x%x rcvsz=%u to=%llu\n",
+		    sample, name, (unsigned long long)native_sb_rows[i].tid,
+		    (unsigned long long)native_sb_rows[i].x1,
+		    (unsigned)(uint32_t)bs, (unsigned)(uint32_t)(bs >> 32),
+		    (unsigned)(uint32_t)rl, (unsigned)(uint32_t)(rl >> 32),
+		    (unsigned)(uint32_t)vi, (unsigned)(uint32_t)(vi >> 32),
+		    (unsigned)(uint32_t)(dr >> 32), (unsigned)(uint32_t)rp,
+		    (unsigned long long)native_sb_rows[i].x7);
+	}
+	if (strncmp(name, "SpringBoard", 11) == 0) {
+		uint64_t uniq[12];
+		unsigned un = 0;
+		int changed = 0;
+		for (unsigned i = 0; i < native_sb_alln && un < 12; i++) {
+			unsigned j;
+			for (j = 0; j < un; j++) {
+				if (uniq[j] == native_sb_all[i].pc) {
+					break;
+				}
+			}
+			if (j == un) {
+				uniq[un++] = native_sb_all[i].pc;
+			}
+		}
+		if (un != native_sb_lastn) {
+			changed = 1;
+		} else {
+			for (unsigned i = 0; i < un; i++) {
+				if (uniq[i] != native_sb_lastpcs[i]) {
+					changed = 1;
+					break;
+				}
+			}
+		}
+		for (unsigned i = 0; i < un; i++) {
+			native_sb_lastpcs[i] = uniq[i];
+		}
+		native_sb_lastn = un;
+		if (!changed) {
+			printf("NATIVE_SBTHR: sample=%u unchanged threads=%u uniq=%u\n",
+			    sample, native_sb_alln, un);
+			goto sbthr_done;
+		}
+		printf("NATIVE_SBTHR: sample=%u comm=%s threads=%u\n", sample, name, native_sb_alln);
+		for (unsigned i = 0; i < native_sb_alln; i++) {
+			printf("NATIVE_SBTHR: sample=%u tid=%llu st=0x%x pc=0x%llx lr=0x%llx\n",
+			    sample, (unsigned long long)native_sb_all[i].tid,
+			    native_sb_all[i].state,
+			    (unsigned long long)native_sb_all[i].pc,
+			    (unsigned long long)native_sb_all[i].lr);
+		}
+sbthr_done:
+		;
+	}
+	/* H239: the buffer of a mach_msg2 call still holds the header of the
+	 * message that was sent last, so read it back and describe both ports. */
+	if (native_sb_capture && native_sb_task != TASK_NULL) {
+		if (native_sb_buf != 0 &&
+		    vm_map_read_user(get_task_map(native_sb_task),
+		    (vm_offset_t)native_sb_buf, native_sb_hdr,
+		    sizeof native_sb_hdr) == KERN_SUCCESS) {
+			native_sb_hdr_ok = 1;
+		}
+		native_sb_probe_name(native_sb_task->itk_space, native_sb_rcv_name, &native_sb_rcv);
+		native_sb_qname1[0] = '-'; native_sb_qname1[1] = 0;
+		if (native_sb_rcv.pid > 0) {
+			proc_name(native_sb_rcv.pid, native_sb_qname1, sizeof native_sb_qname1);
+		}
+		if (native_sb_hdr_ok) {
+			native_sb_probe_name(native_sb_task->itk_space, native_sb_hdr[2], &native_sb_req);
+			native_sb_qname2[0] = '-'; native_sb_qname2[1] = 0;
+			if (native_sb_req.pid > 0) {
+				proc_name(native_sb_req.pid, native_sb_qname2, sizeof native_sb_qname2);
+			}
+		} else {
+			native_sb_qname2[0] = '-'; native_sb_qname2[1] = 0;
+		}
+		printf("NATIVE_SBPORT: sample=%u comm=%s buf=0x%llx hdr=%d bits=0x%x size=%u rport=0x%x lport=0x%x vport=0x%x id=0x%x\n",
+		    sample, name, (unsigned long long)native_sb_buf, native_sb_hdr_ok,
+		    native_sb_hdr[0], native_sb_hdr[1], native_sb_hdr[2],
+		    native_sb_hdr[3], native_sb_hdr[4], native_sb_hdr[5]);
+		printf("NATIVE_SBPORT: sample=%u rcv name=0x%x seen=%d set=%d ie=0x%llx sr=%u ms=%u so=%u q=%d peer=%d/%s\n",
+		    sample, native_sb_rcv_name, native_sb_rcv.seen, native_sb_rcv.is_set,
+		    (unsigned long long)native_sb_rcv.ie_bits,
+		    native_sb_rcv.srights, native_sb_rcv.mscount, native_sb_rcv.sorights,
+		    native_sb_rcv.queued, native_sb_rcv.pid, native_sb_qname1);
+		printf("NATIVE_SBPORT: sample=%u req name=0x%x seen=%d set=%d ie=0x%llx sr=%u ms=%u so=%u q=%d rn=0x%x peer=%d/%s\n",
+		    sample, native_sb_hdr[2], native_sb_req.seen, native_sb_req.is_set,
+		    (unsigned long long)native_sb_req.ie_bits,
+		    native_sb_req.srights, native_sb_req.mscount, native_sb_req.sorights,
+		    native_sb_req.queued, native_sb_req.rname, native_sb_req.pid, native_sb_qname2);
+		native_xpc_register(native_sb_rcv.port, native_sb_pid, name, 'r');
+		native_xpc_register(native_sb_req.port, native_sb_pid, name, 'q');
+		native_xpc_dump(sample);
+	}
+	if (native_sb_task != TASK_NULL) {
+		task_deallocate(native_sb_task);
+		native_sb_task = TASK_NULL;
+	}
+}
+
+
+/* H242: request lifecycle tracing for the SpringBoard -> lsd -> containermanager
+ * chain.  The sampler learns the port objects (pointer only, never dereferenced),
+ * so the send hook is a plain pointer comparison in the hottest path of the IPC
+ * layer: no locks, no allocations, no port lookups.  A message counted as "to"
+ * a tracked port is exactly the request/reply we care about. */
+struct native_xpc_port {
+	uint64_t port;
+	int pid;
+	char owner[17];
+	char role;
+	unsigned long long from;
+	unsigned long long to;
+};
+#define NATIVE_XPC_PORTS 8
+static struct native_xpc_port native_xpc_ports[NATIVE_XPC_PORTS];
+static unsigned native_xpc_port_count;
+static unsigned native_xpc_seq;
+
+static void
+native_xpc_register(uint64_t port, int pid, const char *owner, char role)
+{
+	if (port == 0) {
+		return;
+	}
+	for (unsigned i = 0; i < native_xpc_port_count; i++) {
+		if (native_xpc_ports[i].port == port) {
+			native_xpc_ports[i].pid = pid;
+			strlcpy(native_xpc_ports[i].owner, owner,
+			    sizeof native_xpc_ports[i].owner);
+			native_xpc_ports[i].role = role;
+			return;
+		}
+	}
+	if (native_xpc_port_count >= NATIVE_XPC_PORTS) {
+		return;
+	}
+	native_xpc_ports[native_xpc_port_count].port = port;
+	native_xpc_ports[native_xpc_port_count].pid = pid;
+	strlcpy(native_xpc_ports[native_xpc_port_count].owner, owner,
+	    sizeof native_xpc_ports[native_xpc_port_count].owner);
+	native_xpc_ports[native_xpc_port_count].role = role;
+	native_xpc_port_count++;
+}
+
+/* Called from ipc_kmsg_send() right after the header is fetched and before any
+ * lock is taken; 'remote' is the destination port object stored in the header. */
+void
+native_xpc_send_hook(void *remote, unsigned bits, unsigned size, unsigned id)
+{
+	uint64_t port = (uint64_t)(uintptr_t)remote;
+	char from[17];
+	int pid;
+
+	if (port == 0 || native_xpc_port_count == 0) {
+		return;
+	}
+	pid = proc_getpid(current_proc());
+	for (unsigned i = 0; i < native_xpc_port_count; i++) {
+		if (native_xpc_ports[i].pid == pid) {
+			native_xpc_ports[i].from++;
+			break;
+		}
+	}
+	for (unsigned i = 0; i < native_xpc_port_count; i++) {
+		if (native_xpc_ports[i].port != port) {
+			continue;
+		}
+		native_xpc_ports[i].to++;
+		proc_name(pid, from, sizeof from);
+		printf("NATIVE_XPC: #%u send from=%s(%d) to=%s/%c bits=0x%x size=%u id=0x%x\n",
+		    ++native_xpc_seq, from, pid, native_xpc_ports[i].owner,
+		    native_xpc_ports[i].role, bits, size, id);
+		return;
+	}
+}
+
+static void
+native_xpc_dump(unsigned sample)
+{
+	printf("NATIVE_XPC: sample=%u ports=%u", sample, native_xpc_port_count);
+	for (unsigned i = 0; i < native_xpc_port_count; i++) {
+		printf(" [%s/%c p=0x%llx f=%llu t=%llu]",
+		    native_xpc_ports[i].owner, native_xpc_ports[i].role,
+		    (unsigned long long)native_xpc_ports[i].port,
+		    native_xpc_ports[i].from, native_xpc_ports[i].to);
+	}
+	printf("\n");
+}
+
+
+/* H244: full sender/receiver annotation.  The hook runs with the destination port
+ * already locked by ipc_kmsg_send(), so the receiver task/pid can be read safely
+ * with the kernel's own ipc_port_get_receiver_task_locked().  Only messages where
+ * either side is one of the tracked processes are recorded, and nothing is printed
+ * from the IPC path: entries go into a small ring and the sampler prints them. */
+#include <ipc/ipc_kmsg.h>
+
+struct native_xpc_note {
+	unsigned from;
+	unsigned to;
+	unsigned bits;
+	unsigned size;
+	unsigned id;
+};
+#define NATIVE_XPC_RING 512
+static struct native_xpc_note native_xpc_ring[NATIVE_XPC_RING];
+static unsigned native_xpc_written;
+static unsigned native_xpc_printed;
+static unsigned native_xpc_lost;
+static unsigned long long native_xpc_sb_out, native_xpc_sb_in, native_xpc_sb_other;
+static unsigned long long native_xpc_p_out, native_xpc_p_in, native_xpc_p_other;
+
+static int
+native_xpc_tracked(int pid)
+{
+	if (pid <= 0) {
+		return 0;
+	}
+	for (int i = 0; i < 3; i++) {
+		if (native_xpc_pids[i] == pid) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+void
+native_xpc_note(ipc_kmsg_t kmsg, ipc_port_t port)
+{
+	mach_msg_header_t *hdr = ikm_header(kmsg);
+	int from = proc_getpid(current_proc());
+	int to = ipc_port_get_receiver_task_locked(port, NULL);
+	unsigned w;
+	struct native_xpc_note *e;
+
+	if (!native_xpc_tracked(from) && !native_xpc_tracked(to)) {
+		return;
+	}
+	if ((unsigned)from == (unsigned)native_xpc_pids[0]) {
+		native_xpc_sb_out++;
+	} else if ((unsigned)to == (unsigned)native_xpc_pids[0]) {
+		native_xpc_sb_in++;
+	} else {
+		native_xpc_sb_other++;
+	}
+	w = native_xpc_written;
+	if (w - native_xpc_printed >= NATIVE_XPC_RING) {
+		native_xpc_lost++;
+		w = native_xpc_printed;          /* keep the window sliding */
+	}
+	e = &native_xpc_ring[w % NATIVE_XPC_RING];
+		/* H247: bootstrap look-ups carry the service name inline.  Record only
+	 * that string (never any other message body), from SpringBoard only. */
+	if ((unsigned)from == (unsigned)native_xpc_pids[0] &&
+	    ((unsigned)hdr->msgh_id == 0x40000324u ||
+	    (unsigned)hdr->msgh_id == 0x40000325u)) {
+		const char *base = (const char *)hdr;
+		unsigned msize = (unsigned)hdr->msgh_size;
+		for (unsigned off = 24; off + 11 < msize && off < 240; off++) {
+			char name[48];
+			unsigned len = 0;
+			if (memcmp(base + off, "com.apple.", 10) != 0) {
+				continue;
+			}
+			while (len < sizeof name - 1 && off + len < msize) {
+				char c = base[off + len];
+				if (c < 0x21 || c > 0x7e) {
+					break;
+				}
+				name[len] = c;
+				len++;
+			}
+			name[len] = 0;
+			if (len < 11) {
+				break;
+			}
+			unsigned k;
+			for (k = 0; k < native_xpc_names_n; k++) {
+				if (strncmp(native_xpc_names[k], name, sizeof name) == 0) {
+					break;
+				}
+			}
+			if (k == native_xpc_names_n && native_xpc_names_n < 16) {
+				strlcpy(native_xpc_names[native_xpc_names_n], name, sizeof name);
+				native_xpc_names_n++;
+			}
+			break;
+		}
+	}
+e->from = (unsigned)from;
+	e->to = (unsigned)to;
+	e->bits = (unsigned)hdr->msgh_bits;
+	e->size = (unsigned)hdr->msgh_size;
+	e->id = (unsigned)hdr->msgh_id;
+	native_xpc_written = w + 1;
+}
+
+static void
+native_xpc_emit(unsigned sample, unsigned budget)
+{
+	(void)budget;
+	if (native_xpc_sb_out == native_xpc_p_out &&
+	    native_xpc_sb_in == native_xpc_p_in &&
+	    native_xpc_sb_other == native_xpc_p_other) {
+		return;
+	}
+	printf("NATIVE_XPC3: sample=%u sb_out=%llu sb_in=%llu other=%llu lost=%u\n", sample,
+	    native_xpc_sb_out - native_xpc_p_out, native_xpc_sb_in - native_xpc_p_in,
+	    native_xpc_sb_other - native_xpc_p_other, native_xpc_lost);
+	while (native_xpc_names_printed < native_xpc_names_n) {
+		printf("NATIVE_BOOTSTRAP: sample=%u name=%s\n", sample,
+		    native_xpc_names[native_xpc_names_printed]);
+		native_xpc_names_printed++;
+	}
+	native_xpc_p_out = native_xpc_sb_out;
+	native_xpc_p_in = native_xpc_sb_in;
+	native_xpc_p_other = native_xpc_sb_other;
+}
