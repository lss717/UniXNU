+/* H104i diagnostic only: dump display-side thread wait state. */
+void native_proc_state_dump(void);
+extern struct proc *proc_find(int);
+extern int proc_rele(struct proc *);
+extern struct task *proc_task(struct proc *);
+extern int proc_getpid(struct proc *);
+extern int ipc_mqueue_full;
+typedef int (*native_proc_iterate_fn_t)(struct proc *, void *);
+extern void proc_iterate(unsigned int, native_proc_iterate_fn_t, void *, native_proc_iterate_fn_t, void *);
+
+/* H123: one line per process with the wait state of its main (lowest tid)
+ * thread, so the receiver of a full port queue shows up in the stall snapshot. */
+struct native_wait_row {
+	int pid;
+	char comm[17];
+	unsigned threads;
+	unsigned runnable;
+	unsigned sendblock;
+	uint64_t tid;
+	int state;
+	uint64_t wait;
+	void *cont;
+};
+static struct native_wait_row native_wait_rows[160];
+static unsigned native_wait_row_count;
+
+static int
+native_wait_row_collect(struct proc *p, void *arg)
+{
+	unsigned n = native_wait_row_count;
+	if (n >= sizeof(native_wait_rows) / sizeof(native_wait_rows[0])) {
+		return 0;
+	}
+	struct task *t = proc_task(p);
+	unsigned threads = 0, runnable = 0, sendblock = 0;
+	uint64_t best_tid = 0;
+	int best_state = 0;
+	uint64_t best_wait = 0;
+	void *best_cont = 0;
+	if (t && task_lock_try(t)) {
+		threads = t->thread_count;
+		thread_t th;
+		queue_iterate(&t->threads, th, thread_t, task_threads) {
+			uint64_t tid = thread_tid(th);
+			if ((th->state & (TH_WAIT | TH_UNINT)) == 0) {
+				runnable++;
+			}
+			if ((uint64_t)th->wait_event == (uint64_t)(uintptr_t)&ipc_mqueue_full) {
+				sendblock++;
+			}
+			if (best_tid == 0 || tid < best_tid) {
+				best_tid = tid;
+				best_state = th->state;
+				best_wait = (uint64_t)th->wait_event;
+				best_cont = (void *)th->continuation;
+			}
+		}
+		task_unlock(t);
+	}
+	native_wait_rows[n].pid = proc_getpid(p);
+	proc_name(native_wait_rows[n].pid, native_wait_rows[n].comm,
+	    sizeof(native_wait_rows[n].comm));
+	native_wait_rows[n].threads = threads;
+	native_wait_rows[n].runnable = runnable;
+	native_wait_rows[n].sendblock = sendblock;
+	native_wait_rows[n].tid = best_tid;
+	native_wait_rows[n].state = best_state;
+	native_wait_rows[n].wait = best_wait;
+	native_wait_rows[n].cont = best_cont;
+	native_wait_row_count = n + 1;
+	(void)arg;
+	return 0;
+}
