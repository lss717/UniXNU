index 5dcf00e..999c217 100644
--- a/osfmk/kern/task.c
+++ b/osfmk/kern/task.c
@@ -10285,3 +10285,240 @@ task_best_name(task_t task, char *buf, size_t size)
 	char *name = proc_best_name(task_get_proc_raw(task));
 	strlcpy(buf, name, size);
 }
+
+
+/* H104i diagnostic only: dump display-side thread wait state. */
+void native_proc_state_dump(void);
+extern struct proc *proc_find(int);
+extern int proc_rele(struct proc *);
+extern struct task *proc_task(struct proc *);
+extern int proc_getpid(struct proc *);
+extern int ipc_mqueue_full;
+typedef int (*native_proc_iterate_fn_t)(struct proc *, void *);
+extern void proc_iterate(unsigned int, native_proc_iterate_fn_t, void *, native_proc_iterate_fn_t, void *);
+
+/* H123: one line per process with the wait state of its main (lowest tid)
+ * thread, so the receiver of a full port queue shows up in the stall snapshot. */
+struct native_wait_row {
+	int pid;
+	char comm[17];
+	unsigned threads;
+	unsigned runnable;
+	unsigned sendblock;
+	uint64_t tid;
+	int state;
+	uint64_t wait;
+	void *cont;
+};
+static struct native_wait_row native_wait_rows[160];
+static unsigned native_wait_row_count;
+
+static int
+native_wait_row_collect(struct proc *p, void *arg)
+{
+	unsigned n = native_wait_row_count;
+	if (n >= sizeof(native_wait_rows) / sizeof(native_wait_rows[0])) {
+		return 0;
+	}
+	struct task *t = proc_task(p);
+	unsigned threads = 0, runnable = 0, sendblock = 0;
+	uint64_t best_tid = 0;
+	int best_state = 0;
+	uint64_t best_wait = 0;
+	void *best_cont = 0;
+	if (t && task_lock_try(t)) {
+		threads = t->thread_count;
+		thread_t th;
+		queue_iterate(&t->threads, th, thread_t, task_threads) {
+			uint64_t tid = thread_tid(th);
+			if ((th->state & (TH_WAIT | TH_UNINT)) == 0) {
+				runnable++;
+			}
+			if ((uint64_t)th->wait_event == (uint64_t)(uintptr_t)&ipc_mqueue_full) {
+				sendblock++;
+			}
+			if (best_tid == 0 || tid < best_tid) {
+				best_tid = tid;
+				best_state = th->state;
+				best_wait = (uint64_t)th->wait_event;
+				best_cont = (void *)th->continuation;
+			}
+		}
+		task_unlock(t);
+	}
+	native_wait_rows[n].pid = proc_getpid(p);
+	proc_name(native_wait_rows[n].pid, native_wait_rows[n].comm,
+	    sizeof(native_wait_rows[n].comm));
+	native_wait_rows[n].threads = threads;
+	native_wait_rows[n].runnable = runnable;
+	native_wait_rows[n].sendblock = sendblock;
+	native_wait_rows[n].tid = best_tid;
+	native_wait_rows[n].state = best_state;
+	native_wait_rows[n].wait = best_wait;
+	native_wait_rows[n].cont = best_cont;
+	native_wait_row_count = n + 1;
+	(void)arg;
+	return 0;
+}
+
+/* H124: exported so the UFS driver can print it only at the later stages;
+ * the +2 s snapshot already proved the send-block there is transient. */
+void
+native_proc_wait_graph(void)
+{
+	native_wait_row_count = 0;
+	/* PROC_ALLPROCLIST | PROC_NOWAITTRANS, same as native_proc_summary(). */
+	proc_iterate(1U | 4U, native_wait_row_collect, NULL, NULL, NULL);
+	for (unsigned i = 0; i < native_wait_row_count; i++) {
+		printf("NATIVE_WAIT: pid=%d comm=%s threads=%u run=%u sb=%u tid=%llu st=%x wait=%llx cont=%p\n",
+		    native_wait_rows[i].pid, native_wait_rows[i].comm,
+		    native_wait_rows[i].threads, native_wait_rows[i].runnable,
+		    native_wait_rows[i].sendblock,
+		    (unsigned long long)native_wait_rows[i].tid,
+		    native_wait_rows[i].state,
+		    (unsigned long long)native_wait_rows[i].wait,
+		    native_wait_rows[i].cont);
+	}
+}
+
+void
+native_proc_state_dump(void)
+{
+	printf("NATIVE_PROC_DUMP: begin\n");
+	const int pids[] = { 78, 55, 63, 27, 1 };
+	for (unsigned i = 0; i < sizeof(pids) / sizeof(pids[0]); i++) {
+		printf("NATIVE_PROC_DUMP: find pid=%d\n", pids[i]);
+		struct proc *p = proc_find(pids[i]);
+		if (!p) {
+			printf("NATIVE_PROC_DUMP: pid=%d not found\n", pids[i]);
+			continue;
+		}
+		char name[32] = {};
+		proc_name(pids[i], name, sizeof(name));
+		task_t task = proc_task(p);
+		printf("NATIVE_PROC_DUMP: pid=%d comm=%s task=%p\n", pids[i], name, task);
+		if (task) {
+			struct {
+				uint64_t tid;
+				int state;
+				uint64_t wait;
+				void *cont;
+				void *param;
+				uint16_t opts;
+			} snap[32];
+			unsigned count = 0;
+			if (!task_lock_try(task)) {
+				printf("NATIVE_PROC_DUMP: pid=%d task lock busy\n", pids[i]);
+				proc_rele(p);
+				continue;
+			}
+			thread_t th;
+			queue_iterate(&task->threads, th, thread_t, task_threads) {
+				if (count >= sizeof(snap) / sizeof(snap[0])) {
+					break;
+				}
+				snap[count].tid = thread_tid(th);
+				snap[count].state = th->state;
+				snap[count].wait = (uint64_t)th->wait_event;
+				snap[count].cont = (void *)th->continuation;
+				snap[count].param = th->parameter;
+				snap[count].opts = th->options;
+				count++;
+			}
+			int total = task->thread_count;
+			task_unlock(task);
+			printf("NATIVE_PROC_DUMP: pid=%d threads=%u total=%d\n", pids[i], count, total);
+			for (unsigned j = 0; j < count; j++) {
+				printf("NATIVE_PROC_THREAD: pid=%d tid=%llu state=0x%x wait=%llx cont=%p param=%p opts=0x%x%s\n",
+				    pids[i], (unsigned long long)snap[j].tid, snap[j].state,
+				    (unsigned long long)snap[j].wait, snap[j].cont,
+				    snap[j].param, snap[j].opts,
+				    (uint64_t)snap[j].wait == (uint64_t)(uintptr_t)&ipc_mqueue_full ?
+				    " send-block" : "");
+			}
+		}
+		proc_rele(p);
+	}
+	printf("NATIVE_PROC_DUMP: end\n");
+}
+
+/* H236ij: user-PC samples of a named process, for locating a stuck userspace thread.
+ * Ten samples one second apart separate "blocked" from "spinning"; one sample would only show
+ * the mach_msg trap every healthy thread sits in.  Only TH_WAIT threads are read (kernel threads
+ * have no user state, a thread running on a CPU carries the state of its last trap), the state is
+ * validated, and the pc must look like a user address.  The thread queue is walked under
+ * task_lock_try() and nothing is printed while the lock is held (IOLog can block). */
+#include <mach/arm/thread_status.h>
+extern struct arm_saved_state *get_user_regs(thread_t);
+
+struct native_sb_row {
+	uint64_t tid;
+	uint64_t pc;
+	uint64_t lr;
+	uint64_t wait;
+};
+static struct native_sb_row native_sb_rows[16];
+static unsigned native_sb_count;
+static const char *native_sb_note;
+static const char *native_sb_name;
+
+static int
+native_sb_collect(struct proc *p, void *arg)
+{
+	char comm[17];
+
+	(void)arg;
+	proc_name(proc_getpid(p), comm, sizeof comm);
+	if (strncmp(comm, native_sb_name, strlen(native_sb_name)) != 0) {
+		return 0;
+	}
+	struct task *t = proc_task(p);
+	if (!t) {
+		native_sb_note = "no-task";
+		return 1;
+	}
+	if (!task_lock_try(t)) {
+		native_sb_note = "locked";
+		return 1;
+	}
+	thread_t th;
+	queue_iterate(&t->threads, th, thread_t, task_threads) {
+		if ((th->state & TH_WAIT) == 0) {
+			continue;
+		}
+		arm_saved_state_t *state = get_user_regs(th);
+		if (!state || !is_saved_state64(state)) {
+			continue;
+		}
+		uint64_t pc = get_saved_state_pc(state);
+		if (pc < 0x100000000ULL || pc >= 0x8000000000ULL) {
+			continue;
+		}
+		if (native_sb_count < sizeof(native_sb_rows) / sizeof(native_sb_rows[0])) {
+			native_sb_rows[native_sb_count].tid = thread_tid(th);
+			native_sb_rows[native_sb_count].pc = pc;
+			native_sb_rows[native_sb_count].lr = get_saved_state_lr(state);
+			native_sb_rows[native_sb_count].wait = (uint64_t)(uintptr_t)th->wait_event;
+			native_sb_count++;
+		}
+	}
+	task_unlock(t);
+	return 1;
+}
+
+void
+native_sb_pc_sample(const char *name, unsigned sample)
+{
+	native_sb_count = 0;
+	native_sb_note = "-";
+	native_sb_name = name;
+	proc_iterate(1U | 4U, native_sb_collect, NULL, NULL, NULL);
+	printf("NATIVE_SBPC: sample=%u comm=%s n=%u note=%s\n", sample, name, native_sb_count, native_sb_note);
+	for (unsigned i = 0; i < native_sb_count; i++) {
+		printf("NATIVE_SBPC: sample=%u comm=%s tid=%llu pc=0x%llx lr=0x%llx wait=0x%llx\n", sample, name,
+		    (unsigned long long)native_sb_rows[i].tid,
+		    (unsigned long long)native_sb_rows[i].pc,
+		    (unsigned long long)native_sb_rows[i].lr,
+		    (unsigned long long)native_sb_rows[i].wait);
+	}
+}
