+	*slot_index = __atomic_add_fetch(&gNativeLsdNextSlot, 1,
+	    __ATOMIC_RELAXED) & (NATIVE_LSD_TRACK_SLOTS - 1);
+	slot = &gNativeLsdSlots[*slot_index];
+	__atomic_store_n(&slot->active, 0, __ATOMIC_RELEASE);
+	slot->op = op;
