+	slot->vnode = (uint64_t)(uintptr_t)vp;
+	slot->offset = offset;
+	slot->requested = requested;
+	slot->residual = 0;
+	slot->duration_ns = 0;
+	slot->result = 0;
+	if (path != NULL) {
+		strlcpy(slot->path, path, sizeof slot->path);
+	} else {
+		slot->path[0] = '\0';
