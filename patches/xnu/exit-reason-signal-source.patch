 /*
  * H103 diagnostic only: record selected process exits. This does not alter
  * exit status, signals, launchd behavior or any verification path.
  */
+static void
+native_exit_reason_source(os_reason_t reason, uint32_t *flags,
+    pid_t *sender_pid, char *sender_name, unsigned name_size)
+{
+	kcdata_iter_t iter;
+	kcdata_iter_t item;
+	char *desc;
+	void *data;
+	uint32_t size;
+
+	*flags = reason != OS_REASON_NULL ? reason->osr_flags : 0;
+	*sender_pid = -1;
+	if (name_size != 0) {
+		sender_name[0] = 0;
+	}
+	if (reason == OS_REASON_NULL || reason->osr_kcd_buf == NULL ||
+	    reason->osr_bufsize == 0) {
+		return;
+	}
+	iter = kcdata_iter(reason->osr_kcd_buf, reason->osr_bufsize);
+	if (!kcdata_iter_valid(iter) ||
+	    kcdata_iter_type(iter) != KCDATA_BUFFER_BEGIN_OS_REASON) {
+		return;
+	}
+	item = kcdata_iter_find_type(iter, KCDATA_TYPE_PID);
+	if (kcdata_iter_valid(item) &&
+	    kcdata_iter_size(item) >= KCDATA_DESC_MAXLEN + sizeof(*sender_pid)) {
+		kcdata_iter_get_data_with_desc(item, &desc, &data, &size);
+		if (size >= sizeof(*sender_pid)) {
+			memcpy(sender_pid, data, sizeof(*sender_pid));
+		}
+	}
+	item = kcdata_iter_find_type(iter, KCDATA_TYPE_PROCNAME);
+	if (kcdata_iter_valid(item) && name_size != 0 &&
+	    kcdata_iter_size(item) > KCDATA_DESC_MAXLEN) {
+		kcdata_iter_get_data_with_desc(item, &desc, &data, &size);
+		unsigned limit = size < name_size - 1 ? size : name_size - 1;
+		for (unsigned i = 0; i < limit; i++) {
+			char c = ((const char *)data)[i];
+			if (c == 0) {
+				break;
+			}
+			sender_name[i] = c;
+		}
+		sender_name[limit] = 0;
+	}
+}
