+
+	if (avail > NATIVE_SB_PEERS) {
+		avail = NATIVE_SB_PEERS;
+	}
+	printf("NATIVE_SBPEER: burst=%u total=%u window=%u\n", burst, native_sb_peers_n, avail);
+	for (unsigned i = 0; i < avail && shown < 14; i++) {
+		struct native_sb_peer *pr = &native_sb_peers[(native_sb_peers_n - 1 - i) % NATIVE_SB_PEERS];
+		char fcomm[17], tcomm[17];
+
+		fcomm[0] = '-'; fcomm[1] = 0;
+		tcomm[0] = '-'; tcomm[1] = 0;
+		if (pr->from > 0) {
+			proc_name((int)pr->from, fcomm, sizeof fcomm);
+		}
+		if ((int)pr->to > 0) {
+			proc_name((int)pr->to, tcomm, sizeof tcomm);
+		}
+		printf("NATIVE_SBPEER: burst=%u seq=%u %u/%s -> %u/%s id=0x%x size=%u bits=0x%x\n",
+		    burst, pr->seq, pr->from, fcomm, pr->to, tcomm, pr->id, pr->size, pr->bits);
+		shown++;
+	}
+}
