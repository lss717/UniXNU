+/* H254: the faulting pc of a trap/abort, for the processes that keep dying.
+ * exception_deliver() is the point where the kernel hands the exception to the
+ * handler, so the crashing thread's saved user state is still intact. */
+void
+native_exc_probe(thread_t th, int exc)
+{
+	static uint64_t last_pc;
+	static int last_pid;
+	static unsigned long long last_tid;
+	char comm[17];
+	task_t t;
+	int pid;
+	arm_saved_state_t *st;
+	uint64_t pc = 0, lr = 0;
+
+	if (th == THREAD_NULL) {
+		return;
+	}
+	/* thread->task lives behind the read-only part in this XNU revision. */
+	t = (th->t_tro != NULL) ? th->t_tro->tro_task : TASK_NULL;
+	if (t == TASK_NULL) {
+		return;
+	}
+	pid = task_pid(t);
+	comm[0] = '-';
+	comm[1] = 0;
+	if (pid > 0) {
+		proc_name(pid, comm, sizeof comm);
+	}
+	if (strncmp(comm, "mobileactivation", 16) != 0) {
+		return;
+	}
+	st = get_user_regs(th);
+	if (st != NULL) {
+		pc = get_saved_state_pc(st);
+		lr = get_saved_state_lr(st);
+	}
+	if (pc == last_pc && pid == last_pid && thread_tid(th) == last_tid) {
+		return;
+	}
+	last_pc = pc;
+	last_pid = pid;
+	last_tid = thread_tid(th);
+	printf("NATIVE_EXC: pid=%d comm=%s tid=%llu exc=%d pc=0x%llx lr=0x%llx\n",
+	    pid, comm, (unsigned long long)thread_tid(th), exc,
+	    (unsigned long long)pc, (unsigned long long)lr);
+}
