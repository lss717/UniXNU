+/* H703: bounded short-interval follow of the main thread and the current
+ * lock owner around a park transition (<=3 bursts per boot, 8 samples x
+ * 2.5 s each). Separates reply (owner leaves the wait before the main
+ * thread parks elsewhere), page-in stall (owner pc stays at the same
+ * non-syscall address with TH_WAIT and frozen cpu), and capture gaps.
+ * Re-acquires the task lock per sample; a failed try prints a miss row. */
+static void
+native_lkfollow(unsigned sample, unsigned maintid, unsigned otid)
+{
+	for (unsigned k = 0; k < 8; k++) {
+		IOSleep(2500);
+		if (native_sb_task == TASK_NULL ||
+		    !task_lock_try(native_sb_task)) {
+			printf("NATIVE_LKFOLLOW: sample=%u k=%u miss=locked\n",
+			    sample, k);
+			continue;
+		}
+		thread_t th;
+		queue_iterate(&native_sb_task->threads, th, thread_t,
+		    task_threads) {
+			unsigned tid = (unsigned)thread_tid(th);
+			if (tid != maintid && tid != otid) {
+				continue;
+			}
+			arm_saved_state_t *st = get_user_regs(th);
+			if (!st || !is_saved_state64(st)) {
+				continue;
+			}
+			printf("NATIVE_LKFOLLOW: sample=%u k=%u tid=%u "
+			    "pc=0x%llx lr=0x%llx wait=0x%llx cpu=%u state=0x%x "
+			    "x16=%u x1=0x%llx val=0x%llx kmsg=%u rname=0x%x\n",
+			    sample, k, tid,
+			    (unsigned long long)get_saved_state_pc(st),
+			    (unsigned long long)get_saved_state_lr(st),
+			    (unsigned long long)(uintptr_t)th->wait_event,
+			    th->cpu_usage, th->state,
+			    (unsigned)(uint32_t)get_saved_state_reg(st, 16),
+			    (unsigned long long)get_saved_state_reg(st, 1),
+			    (unsigned long long)get_saved_state_reg(st, 2),
+			    th->ith_kmsg != IKM_NULL ? 1u : 0u,
+			    th->ith_receiver_name);
+		}
+		task_unlock(native_sb_task);
+	}
 }
 
