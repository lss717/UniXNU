@@ -109,6 +109,8 @@
 static struct native_lsd_track_slot gNativeLsdSlots[NATIVE_LSD_TRACK_SLOTS];
 static uint32_t gNativeLsdNextOp;
+static uint32_t gNativeLsdGateEmitted;
+static uint32_t gNativeLsdGatePending;
 static uint64_t gNativeLsdActive;
