-	    "slow5000=%llu max_ms=%llu errors=%llu first_ops=%u\n",
+	    "slow5000=%llu max_ms=%llu errors=%llu first_ops=%u stable=1\n",
 	    sample,
 	    __atomic_load_n(&gNativeLsdTotals[NATIVE_LSD_FS_OPEN], __ATOMIC_RELAXED),
 	    __atomic_load_n(&gNativeLsdTotals[NATIVE_LSD_FS_READ], __ATOMIC_RELAXED),
@@ -291,27 +311,20 @@ native_lsd_gate(uint32_t sample)
 	    __atomic_load_n(&gNativeLsdSlow5000, __ATOMIC_RELAXED),
 	    __atomic_load_n(&gNativeLsdMaxNs, __ATOMIC_RELAXED) / 1000000ULL,
 	    __atomic_load_n(&gNativeLsdErrors, __ATOMIC_RELAXED),
-	    __atomic_load_n(&gNativeLsdNextOp, __ATOMIC_RELAXED));
+	    next_ops);
 	for (uint32_t i = 0; i < NATIVE_LSD_TRACK_SLOTS; i++) {
 		struct native_lsd_track_slot *slot = &gNativeLsdSlots[i];
 		uint32_t active = __atomic_load_n(&slot->active, __ATOMIC_ACQUIRE);
-		uint64_t end_abs = slot->end_abs;
-		uint64_t ns = slot->duration_ns;
-		if (active && slot->start_abs != 0) {
-			end_abs = mach_absolute_time();
-			absolutetime_to_nanoseconds(end_abs - slot->start_abs, &ns);
-		}
-		if (slot->op != 0) {
-			printf("NATIVE_LS_GATE_SLOT: sample=%u slot=%u seq=%u pid=%u "
-			    "op=%u tid=%llu vnode=0x%llx active=%u offset=%lld "
-			    "requested=%llu residual=%llu start_abs=%llu end_abs=%llu "
-			    "ms=%llu result=%d name=%s path=%s\n",
-			    sample, i, slot->sequence, slot->pid, slot->op, slot->tid,
-			    slot->vnode, active, (long long)slot->offset, slot->requested,
-			    slot->residual, slot->start_abs, end_abs, ns / 1000000ULL,
-			    slot->result, slot->name, slot->path);
-		}
+		printf("NATIVE_LS_GATE_SLOT: sample=%u slot=%u seq=%u pid=%u "
+		    "op=%u tid=%llu vnode=0x%llx active=%u offset=%lld "
+		    "requested=%llu residual=%llu start_abs=%llu end_abs=%llu "
+		    "ms=%llu result=%d name=%s path=%s stable=1\n",
+		    sample, i, slot->sequence, slot->pid, slot->op, slot->tid,
+		    slot->vnode, active, (long long)slot->offset, slot->requested,
+		    slot->residual, slot->start_abs, slot->end_abs,
+		    slot->duration_ns / 1000000ULL, slot->result, slot->name,
+		    slot->path);
 	}
 }
