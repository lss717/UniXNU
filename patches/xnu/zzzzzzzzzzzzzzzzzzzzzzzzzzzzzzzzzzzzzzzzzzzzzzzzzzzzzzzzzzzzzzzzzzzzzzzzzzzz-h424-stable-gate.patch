 void
 native_lsd_gate(uint32_t sample)
 {
+	uint32_t complete = 1;
+	uint32_t next_ops;
+	uint32_t seen = 0;
+	uint64_t active;
+
+	if (__atomic_load_n(&gNativeLsdGateEmitted, __ATOMIC_ACQUIRE) != 0) {
+		return;
+	}
+	for (uint32_t i = 0; i < NATIVE_LSD_TRACK_SLOTS; i++) {
+		struct native_lsd_track_slot *slot = &gNativeLsdSlots[i];
+		uint32_t slot_active =
+		    __atomic_load_n(&slot->active, __ATOMIC_ACQUIRE);
+
+		if (slot_active || slot->sequence != i + 1 || slot->end_abs == 0) {
+			complete = 0;
+		}
+		if (slot->sequence != 0) {
+			seen++;
+		}
+	}
+	next_ops = __atomic_load_n(&gNativeLsdNextOp, __ATOMIC_RELAXED);
+	active = __atomic_load_n(&gNativeLsdActive, __ATOMIC_RELAXED);
+	if (!complete) {
+		if (__atomic_exchange_n(&gNativeLsdGatePending, 1,
+		    __ATOMIC_RELAXED) == 0) {
+			printf("NATIVE_LS_GATE_PENDING: sample=%u next_ops=%u "
+			    "seen=%u active=%llu\n", sample, next_ops, seen,
+			    (unsigned long long)active);
+		}
+		return;
+	}
+	if (__atomic_exchange_n(&gNativeLsdGateEmitted, 1,
+	    __ATOMIC_ACQ_REL) != 0) {
+		return;
+	}
 	printf("NATIVE_LS_GATE: sample=%u opens=%llu reads=%llu writes=%llu "
