--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8021,9 +8021,53 @@
 	mach_vm_size_t map_page_size = vm_map_page_size(map);
 
 	(void) mach_vm_allocate_kernel(map, &scratch_addr, map_page_size, VM_FLAGS_ANYWHERE, VM_KERN_MEMORY_NONE);
 	user_addr_t init_envp = USER_ADDR_NULL;
 #if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
 	boot_progress_stage("SystemOS mount enter");
 	int cache_error = native_owner_cache_prepare(p, (user_addr_t)scratch_addr, &init_envp);
 	boot_progress_stage("SystemOS mount returned");
+	{
+		static const char *const paths[] = {
+		    "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64",
+		    "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.01",
+		    "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.02",
+		    "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.03",
+		    "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.04",
+		    "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.05",
+		    "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.06",
+		    "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.07",
+		    "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.08",
+		    "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.09",
+		    "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.symbols",
+		};
+		uint64_t size[11] = {0};
+		int lookup_err[11] = {0};
+		int i;
+		for (i = 0; i < 11; i++) {
+			vnode_t probe = NULLVP;
+			struct vnode_attr nva;
+			lookup_err[i] = vnode_lookup(paths[i], 0, &probe, vfs_context_kernel());
+			if (probe) {
+				VATTR_INIT(&nva);
+				VATTR_WANTED(&nva, va_data_size);
+				if (vnode_getattr(probe, &nva, vfs_context_kernel()) == 0 &&
+				    VATTR_IS_SUPPORTED(&nva, va_data_size)) {
+					size[i] = nva.va_data_size;
+				}
+				vnode_put(probe); probe = NULLVP;
+			}
+		}
+		panic("NATIVE_SYSTEMOS: main=%llu s1=%llu s2=%llu s3=%llu s4=%llu s5=%llu "
+		    "s6=%llu s7=%llu s8=%llu s9=%llu sym=%llu e1=%d e2=%d e3=%d e4=%d "
+		    "e5=%d e6=%d e7=%d e8=%d e9=%d esym=%d",
+		    (unsigned long long)size[0], (unsigned long long)size[1],
+		    (unsigned long long)size[2], (unsigned long long)size[3],
+		    (unsigned long long)size[4], (unsigned long long)size[5],
+		    (unsigned long long)size[6], (unsigned long long)size[7],
+		    (unsigned long long)size[8], (unsigned long long)size[9],
+		    (unsigned long long)size[10],
+		    lookup_err[1], lookup_err[2], lookup_err[3], lookup_err[4],
+		    lookup_err[5], lookup_err[6], lookup_err[7], lookup_err[8],
+		    lookup_err[9], lookup_err[10]);
+	}
 	if (cache_error) panic("offline owner SystemOS mount failed: %d", cache_error);
