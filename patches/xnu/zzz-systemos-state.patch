--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8021,9 +8021,124 @@
 	mach_vm_size_t map_page_size = vm_map_page_size(map);
 
 	(void) mach_vm_allocate_kernel(map, &scratch_addr, map_page_size, VM_FLAGS_ANYWHERE, VM_KERN_MEMORY_NONE);
 	user_addr_t init_envp = USER_ADDR_NULL;
 #if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
 	boot_progress_stage("SystemOS mount enter");
 	int cache_error = native_owner_cache_prepare(p, (user_addr_t)scratch_addr, &init_envp);
 	boot_progress_stage("SystemOS mount returned");
+	{
+		vnode_t probe = NULLVP;
+		struct vnode_attr nva;
+		uint64_t size = 0, cs_off = 0, cs_size = 0;
+		uint32_t sub_off = 0, sub_cnt = 0;
+		static uint8_t hdr[0x400];
+		static uint8_t subs[64 * 56];
+		static uint8_t shdr[0x400];
+		int lookup_err = -1, stat_err = -1, open_err = -1, read_err = -1, sub_err = -1;
+		int ok = 0, fail = 0, fail_reason = -1;
+		uint64_t fail_size = 0, fail_cs_off = 0, fail_cs_size = 0;
+		uint32_t fail_map_cnt = 0, fail_map_off = 0, fail_prot = 0;
+		char fail_sfx[33] = {0};
+		lookup_err = vnode_lookup("/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64",
+		    0, &probe, vfs_context_kernel());
+		if (probe) {
+			VATTR_INIT(&nva);
+			VATTR_WANTED(&nva, va_data_size);
+			stat_err = vnode_getattr(probe, &nva, vfs_context_kernel());
+			if (stat_err == 0 && VATTR_IS_SUPPORTED(&nva, va_data_size)) {
+				size = nva.va_data_size;
+			}
+			open_err = VNOP_OPEN(probe, FREAD, vfs_context_kernel());
+			if (open_err == 0) {
+				read_err = vn_rdwr(UIO_READ, probe, (caddr_t)hdr, sizeof(hdr), 0,
+				    UIO_SYSSPACE, IO_NOAUTH, NOCRED, NULL, current_proc());
+				memcpy(&cs_off, hdr + 40, 8);
+				memcpy(&cs_size, hdr + 48, 8);
+				memcpy(&sub_off, hdr + 392, 4);
+				memcpy(&sub_cnt, hdr + 396, 4);
+				if (sub_cnt > 0 && sub_cnt <= 64 && sub_off < size &&
+				    (uint64_t)sub_off + (uint64_t)sub_cnt * 56 <= size) {
+					sub_err = vn_rdwr(UIO_READ, probe, (caddr_t)subs,
+					    (int)(sub_cnt * 56), (off_t)sub_off, UIO_SYSSPACE,
+					    IO_NOAUTH, NOCRED, NULL, current_proc());
+				}
+				(void)VNOP_CLOSE(probe, 0, vfs_context_kernel());
+			}
+			vnode_put(probe); probe = NULLVP;
+		}
+		if (sub_err == 0) {
+			int i;
+			for (i = 0; i < (int)sub_cnt; i++) {
+				char sfx[33] = {0};
+				char path[160];
+				vnode_t subvp = NULLVP;
+				struct vnode_attr sna;
+				uint64_t ssize = 0, scs_off = 0, scs_size = 0, sfile_off = 0;
+				uint32_t smap_off = 0, smap_cnt = 0, splat = 0, sprot = 0;
+				int e, so, sr, reason = -1;
+				memcpy(sfx, subs + i * 56 + 24, 32);
+				strlcpy(path, "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64",
+				    sizeof(path));
+				strlcat(path, sfx, sizeof(path));
+				e = vnode_lookup(path, 0, &subvp, vfs_context_kernel());
+				if (e) { reason = 8; }
+				if (reason == -1) {
+					VATTR_INIT(&sna);
+					VATTR_WANTED(&sna, va_data_size);
+					if (vnode_getattr(subvp, &sna, vfs_context_kernel()) != 0 ||
+					    !VATTR_IS_SUPPORTED(&sna, va_data_size)) { reason = 9; }
+					else ssize = sna.va_data_size;
+				}
+				so = -1;
+				if (reason == -1) {
+					so = VNOP_OPEN(subvp, FREAD, vfs_context_kernel());
+					if (so) reason = 10;
+				}
+				if (reason == -1) {
+					sr = vn_rdwr(UIO_READ, subvp, (caddr_t)shdr, sizeof(shdr), 0,
+					    UIO_SYSSPACE, IO_NOAUTH, NOCRED, NULL, current_proc());
+					if (sr) reason = 6;
+				}
+				if (reason == -1) {
+					memcpy(&scs_off, shdr + 40, 8);
+					memcpy(&scs_size, shdr + 48, 8);
+					memcpy(&smap_off, shdr + 16, 4);
+					memcpy(&smap_cnt, shdr + 20, 4);
+					memcpy(&splat, shdr + 216, 4);
+					if (memcmp(shdr, "dyld_v1  arm64", 14) != 0) reason = 1;
+					else if (splat != 2) reason = 2;
+					else if (smap_cnt == 0 || smap_off + 32 > sizeof(shdr)) reason = 3;
+					else {
+						memcpy(&sfile_off, shdr + smap_off + 16, 8);
+						memcpy(&sprot, shdr + smap_off + 24, 4);
+						if (scs_off + scs_size != ssize) reason = 5;
+						else if (sfile_off != 0) reason = 4;
+						else if (sprot != 5 && sprot != 1) reason = 7;
+					}
+				}
+				if (so == 0) (void)VNOP_CLOSE(subvp, 0, vfs_context_kernel());
+				if (subvp) vnode_put(subvp);
+				if (reason != -1) {
+					fail++;
+					fail_reason = reason;
+					fail_size = ssize;
+					fail_cs_off = scs_off;
+					fail_cs_size = scs_size;
+					fail_map_cnt = smap_cnt;
+					fail_map_off = smap_off;
+					fail_prot = sprot;
+					strlcpy(fail_sfx, sfx, sizeof(fail_sfx));
+					break;
+				}
+				ok++;
+			}
+		}
+		panic("NATIVE_SYSTEMOS: size=%llu cs=%llu+%llu sub=%u/%u read2=%d ok=%d fail=%d "
+		    "sfx=%s reason=%d fsize=%llu fcs=%llu+%llu fmap=%u@%u fprot=%x",
+		    (unsigned long long)size, (unsigned long long)cs_off,
+		    (unsigned long long)cs_size, sub_off, sub_cnt, sub_err, ok, fail,
+		    fail_sfx, fail_reason, (unsigned long long)fail_size,
+		    (unsigned long long)fail_cs_off, (unsigned long long)fail_cs_size,
+		    fail_map_cnt, fail_map_off, fail_prot);
+	}
 	if (cache_error) panic("offline owner SystemOS mount failed: %d", cache_error);
