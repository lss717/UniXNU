--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8021,9 +8021,60 @@
 	mach_vm_size_t map_page_size = vm_map_page_size(map);
 
 	(void) mach_vm_allocate_kernel(map, &scratch_addr, map_page_size, VM_FLAGS_ANYWHERE, VM_KERN_MEMORY_NONE);
 	user_addr_t init_envp = USER_ADDR_NULL;
 #if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
 	boot_progress_stage("SystemOS mount enter");
 	int cache_error = native_owner_cache_prepare(p, (user_addr_t)scratch_addr, &init_envp);
 	boot_progress_stage("SystemOS mount returned");
+	{
+		vnode_t probe = NULLVP;
+		struct vnode_attr nva;
+		uint64_t size = 0, cs_off = 0, cs_size = 0;
+		uint64_t map_addr = 0, map_size = 0, map_off = 0;
+		uint64_t srs = 0, srs_size = 0, max_slide = 0;
+		uint32_t map_maxprot = 0, map_initprot = 0;
+		uint32_t images_off = 0, images_cnt = 0, osver = 0, alt_plat = 0, alt_ver = 0;
+		static uint8_t hdr[0x400];
+		int lookup_err = -1, stat_err = -1, open_err = -1, read_err = -1;
+		lookup_err = vnode_lookup("/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64",
+		    0, &probe, vfs_context_kernel());
+		if (probe) {
+			VATTR_INIT(&nva);
+			VATTR_WANTED(&nva, va_data_size);
+			stat_err = vnode_getattr(probe, &nva, vfs_context_kernel());
+			if (stat_err == 0 && VATTR_IS_SUPPORTED(&nva, va_data_size)) {
+				size = nva.va_data_size;
+			}
+			open_err = VNOP_OPEN(probe, FREAD, vfs_context_kernel());
+			if (open_err == 0) {
+				read_err = vn_rdwr(UIO_READ, probe, (caddr_t)hdr, sizeof(hdr), 0,
+				    UIO_SYSSPACE, IO_NOAUTH, NOCRED, NULL, current_proc());
+				(void)VNOP_CLOSE(probe, 0, vfs_context_kernel());
+			}
+			vnode_put(probe); probe = NULLVP;
+		}
+		memcpy(&cs_off, hdr + 40, 8);
+		memcpy(&cs_size, hdr + 48, 8);
+		memcpy(&map_addr, hdr + 512, 8);
+		memcpy(&map_size, hdr + 520, 8);
+		memcpy(&map_off, hdr + 528, 8);
+		memcpy(&map_maxprot, hdr + 536, 4);
+		memcpy(&map_initprot, hdr + 540, 4);
+		memcpy(&srs, hdr + 224, 8);
+		memcpy(&srs_size, hdr + 232, 8);
+		memcpy(&max_slide, hdr + 240, 8);
+		memcpy(&osver, hdr + 364, 4);
+		memcpy(&alt_plat, hdr + 368, 4);
+		memcpy(&alt_ver, hdr + 372, 4);
+		memcpy(&images_off, hdr + 448, 4);
+		memcpy(&images_cnt, hdr + 452, 4);
+		panic("NATIVE_SYSTEMOS: size=%llu cs=%llu+%llu m=%llu/%llu@%llu prot=%x/%x "
+		    "srs=%llu/%llu slide=%llu os=%x alt=%u/%x imgs=%u/%u",
+		    (unsigned long long)size, (unsigned long long)cs_off,
+		    (unsigned long long)cs_size, (unsigned long long)map_addr,
+		    (unsigned long long)map_size, (unsigned long long)map_off,
+		    map_maxprot, map_initprot, (unsigned long long)srs,
+		    (unsigned long long)srs_size, (unsigned long long)max_slide,
+		    osver, alt_plat, alt_ver, images_off, images_cnt);
+	}
 	if (cache_error) panic("offline owner SystemOS mount failed: %d", cache_error);
