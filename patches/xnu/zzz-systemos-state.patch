--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8021,9 +8021,89 @@
 	mach_vm_size_t map_page_size = vm_map_page_size(map);
 
 	(void) mach_vm_allocate_kernel(map, &scratch_addr, map_page_size, VM_FLAGS_ANYWHERE, VM_KERN_MEMORY_NONE);
 	user_addr_t init_envp = USER_ADDR_NULL;
 #if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
 	boot_progress_stage("SystemOS mount enter");
 	int cache_error = native_owner_cache_prepare(p, (user_addr_t)scratch_addr, &init_envp);
 	boot_progress_stage("SystemOS mount returned");
+	{
+		vnode_t probe = NULLVP;
+		struct vnode_attr nva;
+		uint64_t size = 0;
+		static uint8_t hdr[0x400];
+		static uint8_t subs[64 * 56];
+		static uint8_t shdr[0x100];
+		uint32_t sub_off = 0, sub_cnt = 0;
+		int lookup_err = -1, stat_err = -1, open_err = -1, read_err = -1, sub_err = -1;
+		int ok = 0, miss = 0, first_missing_err = 0, uuid_match = -1;
+		char sfx0[33] = {0}, sfx1[33] = {0}, sfxlast[33] = {0}, first_missing[33] = {0};
+		lookup_err = vnode_lookup("/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64",
+		    0, &probe, vfs_context_kernel());
+		if (probe) {
+			VATTR_INIT(&nva);
+			VATTR_WANTED(&nva, va_data_size);
+			stat_err = vnode_getattr(probe, &nva, vfs_context_kernel());
+			if (stat_err == 0 && VATTR_IS_SUPPORTED(&nva, va_data_size)) {
+				size = nva.va_data_size;
+			}
+			open_err = VNOP_OPEN(probe, FREAD, vfs_context_kernel());
+			if (open_err == 0) {
+				read_err = vn_rdwr(UIO_READ, probe, (caddr_t)hdr, sizeof(hdr), 0,
+				    UIO_SYSSPACE, IO_NOAUTH, NOCRED, NULL, current_proc());
+				memcpy(&sub_off, hdr + 392, 4);
+				memcpy(&sub_cnt, hdr + 396, 4);
+				if (sub_cnt > 0 && sub_cnt <= 64 && sub_off < size &&
+				    (uint64_t)sub_off + (uint64_t)sub_cnt * 56 <= size) {
+					sub_err = vn_rdwr(UIO_READ, probe, (caddr_t)subs,
+					    (int)(sub_cnt * 56), (off_t)sub_off, UIO_SYSSPACE,
+					    IO_NOAUTH, NOCRED, NULL, current_proc());
+				}
+				(void)VNOP_CLOSE(probe, 0, vfs_context_kernel());
+			}
+			vnode_put(probe); probe = NULLVP;
+		}
+		if (sub_err == 0) {
+			int i;
+			memcpy(sfx0, subs + 24, 32);
+			memcpy(sfx1, subs + 56 + 24, 32);
+			memcpy(sfxlast, subs + (sub_cnt - 1) * 56 + 24, 32);
+			for (i = 0; i < (int)sub_cnt; i++) {
+				char sfx[33] = {0};
+				char path[160];
+				vnode_t subvp = NULLVP;
+				int e;
+				memcpy(sfx, subs + i * 56 + 24, 32);
+				strlcpy(path, "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64",
+				    sizeof(path));
+				strlcat(path, sfx, sizeof(path));
+				e = vnode_lookup(path, 0, &subvp, vfs_context_kernel());
+				if (e) {
+					miss++;
+					if (first_missing[0] == 0) {
+						strlcpy(first_missing, sfx, sizeof(first_missing));
+						first_missing_err = e;
+					}
+				} else {
+					ok++;
+					if (i == 0) {
+						int oe = VNOP_OPEN(subvp, FREAD, vfs_context_kernel());
+						if (oe == 0) {
+							if (vn_rdwr(UIO_READ, subvp, (caddr_t)shdr,
+							    sizeof(shdr), 0, UIO_SYSSPACE, IO_NOAUTH,
+							    NOCRED, NULL, current_proc()) == 0) {
+								uuid_match = memcmp(subs, shdr + 88, 16) == 0;
+							}
+							(void)VNOP_CLOSE(subvp, 0, vfs_context_kernel());
+						}
+					}
+					vnode_put(subvp); subvp = NULLVP;
+				}
+			}
+		}
+		panic("NATIVE_SYSTEMOS: size=%llu lookup=%d stat=%d open=%d read=%d "
+		    "sub=%u/%u read2=%d ok=%d miss=%d miss0=%s e0=%d sfx0=%s sfx1=%s last=%s umatch=%d",
+		    (unsigned long long)size, lookup_err, stat_err, open_err, read_err,
+		    sub_off, sub_cnt, sub_err, ok, miss, first_missing, first_missing_err,
+		    sfx0, sfx1, sfxlast, uuid_match);
+	}
 	if (cache_error) panic("offline owner SystemOS mount failed: %d", cache_error);
