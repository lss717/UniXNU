--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8021,9 +8021,42 @@
 	mach_vm_size_t map_page_size = vm_map_page_size(map);
 
 	(void) mach_vm_allocate_kernel(map, &scratch_addr, map_page_size, VM_FLAGS_ANYWHERE, VM_KERN_MEMORY_NONE);
 	user_addr_t init_envp = USER_ADDR_NULL;
 #if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
 	boot_progress_stage("SystemOS mount enter");
 	int cache_error = native_owner_cache_prepare(p, (user_addr_t)scratch_addr, &init_envp);
 	boot_progress_stage("SystemOS mount returned");
+	{
+		vnode_t probe = NULLVP;
+		struct vnode_attr nva;
+		uint64_t size = 0;
+		uint8_t magic[16] = {0};
+		uint32_t m0 = 0, m1 = 0, m2 = 0, m3 = 0;
+		int lookup_err = -1, stat_err = -1, open_err = -1, read_err = -1;
+		lookup_err = vnode_lookup("/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64",
+		    0, &probe, vfs_context_kernel());
+		if (probe) {
+			VATTR_INIT(&nva);
+			VATTR_WANTED(&nva, va_data_size);
+			stat_err = vnode_getattr(probe, &nva, vfs_context_kernel());
+			if (stat_err == 0 && VATTR_IS_SUPPORTED(&nva, va_data_size)) {
+				size = nva.va_data_size;
+			}
+			open_err = VNOP_OPEN(probe, FREAD, vfs_context_kernel());
+			if (open_err == 0) {
+				read_err = vn_rdwr(UIO_READ, probe, (caddr_t)magic, sizeof(magic), 0,
+				    UIO_SYSSPACE, IO_NOAUTH, NOCRED, NULL, current_proc());
+				(void)VNOP_CLOSE(probe, 0, vfs_context_kernel());
+			}
+			vnode_put(probe); probe = NULLVP;
+		}
+		memcpy(&m0, magic, 4);
+		memcpy(&m1, magic + 4, 4);
+		memcpy(&m2, magic + 8, 4);
+		memcpy(&m3, magic + 12, 4);
+		panic("NATIVE_SYSTEMOS: main=%llu lookup=%d stat=%d open=%d read=%d "
+		    "magic=%08x%08x%08x%08x",
+		    (unsigned long long)size, lookup_err, stat_err, open_err, read_err,
+		    m0, m1, m2, m3);
+	}
 	if (cache_error) panic("offline owner SystemOS mount failed: %d", cache_error);
