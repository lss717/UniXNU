--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8021,9 +8021,77 @@
 	mach_vm_size_t map_page_size = vm_map_page_size(map);
 
 	(void) mach_vm_allocate_kernel(map, &scratch_addr, map_page_size, VM_FLAGS_ANYWHERE, VM_KERN_MEMORY_NONE);
 	user_addr_t init_envp = USER_ADDR_NULL;
 #if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
 	boot_progress_stage("SystemOS mount enter");
 	int cache_error = native_owner_cache_prepare(p, (user_addr_t)scratch_addr, &init_envp);
 	boot_progress_stage("SystemOS mount returned");
+	vnode_t probe = NULLVP;
+	struct vnode_attr nva;
+	uint64_t arm64_size = 0, dyld_size = 0, libsys_size = 0;
+	int cache_dir_err, arm64_err, arm64e_err, split1_err, split2_err, symbols_err;
+	int dyld_err, libsys_err, dyld_dir_err;
+
+	boot_progress_stage("diag cache dir");
+	cache_dir_err = vnode_lookup("/System/Library/Caches/com.apple.dyld", 0,
+	    &probe, vfs_context_kernel());
+	if (probe) { vnode_put(probe); probe = NULLVP; }
+	boot_progress_stage("diag arm64 lookup");
+	arm64_err = vnode_lookup("/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64", 0,
+	    &probe, vfs_context_kernel());
+	if (probe) {
+		boot_progress_stage("diag arm64 stat");
+		VATTR_INIT(&nva);
+		if (vnode_getattr(probe, &nva, vfs_context_kernel()) == 0) arm64_size = nva.va_data_size;
+		boot_progress_stage("diag arm64 put");
+		vnode_put(probe); probe = NULLVP;
+	}
+	boot_progress_stage("diag arm64e lookup");
+	arm64e_err = vnode_lookup("/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64e", 0,
+	    &probe, vfs_context_kernel());
+	if (probe) { vnode_put(probe); probe = NULLVP; }
+	boot_progress_stage("diag split1 lookup");
+	split1_err = vnode_lookup("/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.01", 0,
+	    &probe, vfs_context_kernel());
+	if (probe) { vnode_put(probe); probe = NULLVP; }
+	boot_progress_stage("diag split2 lookup");
+	split2_err = vnode_lookup("/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.02", 0,
+	    &probe, vfs_context_kernel());
+	if (probe) { vnode_put(probe); probe = NULLVP; }
+	boot_progress_stage("diag symbols lookup");
+	symbols_err = vnode_lookup("/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.symbols", 0,
+	    &probe, vfs_context_kernel());
+	if (probe) { vnode_put(probe); probe = NULLVP; }
+	boot_progress_stage("diag dyld lookup");
+	dyld_err = vnode_lookup("/usr/lib/dyld", 0, &probe, vfs_context_kernel());
+	if (probe) {
+		boot_progress_stage("diag dyld stat");
+		VATTR_INIT(&nva);
+		if (vnode_getattr(probe, &nva, vfs_context_kernel()) == 0) dyld_size = nva.va_data_size;
+		boot_progress_stage("diag dyld put");
+		vnode_put(probe); probe = NULLVP;
+	}
+	boot_progress_stage("diag libSystem lookup");
+	libsys_err = vnode_lookup("/usr/lib/libSystem.B.dylib", 0, &probe, vfs_context_kernel());
+	if (probe) {
+		boot_progress_stage("diag libSystem stat");
+		VATTR_INIT(&nva);
+		if (vnode_getattr(probe, &nva, vfs_context_kernel()) == 0) libsys_size = nva.va_data_size;
+		boot_progress_stage("diag libSystem put");
+		vnode_put(probe); probe = NULLVP;
+	}
+	boot_progress_stage("diag dyldDir lookup");
+	dyld_dir_err = vnode_lookup("/System/Library/dyld", 0, &probe, vfs_context_kernel());
+	if (probe) { vnode_put(probe); probe = NULLVP; }
