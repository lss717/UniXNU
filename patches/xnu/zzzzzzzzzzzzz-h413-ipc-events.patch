+void
+native_ipc_event_note(unsigned kind, ipc_kmsg_t kmsg, ipc_port_t port,
+    int from_pid, int to_pid, uint64_t receiver_tid, unsigned result)
+{
+	mach_msg_header_t *hdr = kmsg ? ikm_header(kmsg) : NULL;
+	unsigned w;
+	struct native_ipc_event *e;
+	if (from_pid == -2) {
+		from_pid = proc_getpid(current_proc());
+	}
+	if (!native_xpc_tracked(from_pid) && !native_xpc_tracked(to_pid)) {
+		return;
+	}
+	w = __atomic_fetch_add(&native_ipc_events_written, 1, __ATOMIC_RELAXED);
+	if (w >= NATIVE_IPC_EVENT_RING) {
+		__atomic_fetch_add(&native_ipc_events_lost, 1, __ATOMIC_RELAXED);
+	}
+	e = &native_ipc_events[w % NATIVE_IPC_EVENT_RING];
+	e->serial = w + 1;
+	e->port = (uint64_t)(uintptr_t)port;
+	e->receiver_tid = receiver_tid;
+	e->from = from_pid;
+	e->to = to_pid;
+	e->id = hdr ? (unsigned)hdr->msgh_id : 0;
+	e->size = hdr ? (unsigned)hdr->msgh_size : 0;
+	e->bits = hdr ? (unsigned)hdr->msgh_bits : 0;
+	e->kind = kind;
+	e->result = result;
