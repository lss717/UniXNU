diff --git a/bsd/kern/kern_sig.c b/bsd/kern/kern_sig.c
--- a/bsd/kern/kern_sig.c
+++ b/bsd/kern/kern_sig.c
@@ -119,6 +119,11 @@
 #include <mach/exception.h>
 #include <mach/task.h>
 #include <mach/thread_act.h>
+#include <mach/arm/thread_status.h>
+
+extern struct arm_saved_state *get_user_regs(thread_t);
+extern kern_return_t copyinmap(vm_map_t, user_addr_t, void *, vm_size_t);
+extern vm_map_t get_task_map(task_t);
 #include <libkern/OSAtomic.h>
 
 #include <sys/sdt.h>
@@ -2601,18 +2606,29 @@
 struct native_sigrec {
 	uint32_t pid;
 	int sig;
+	uint64_t tid;
 	uint64_t caller;
 	uint32_t sender_pid;
 	uint32_t reason_ns;
 	uint64_t reason_code;
 	uint64_t reason_flags;
+	uint64_t pc;
+	uint64_t lr;
+	uint64_t sp;
+	uint64_t fp;
+	uint64_t x0;
+	uint64_t x1;
+	uint64_t x16;
+	uint32_t stack_ok;
+	uint64_t stack[24];
 	char comm[16];
 	char sender_comm[16];
 };
 static struct native_sigrec native_sig_ring[NATIVE_SIGREC_N];
 static volatile uint32_t native_sig_head;
 static volatile uint32_t native_sig_tail;
 static volatile uint32_t native_sig_dropped;
+static volatile uint32_t native_sb_abort_samples;
 
 static void
 native_sigbus_probe(proc_t p, int signum, struct os_reason *reason, void *caller)
@@ -2612,5 +2639,6 @@
 	struct native_sigrec *r;
 	proc_t sender;
+	thread_t thread;
 	uint32_t slot;
 	int pid = proc_getpid(p);
 
@@ -2625,9 +2653,31 @@
 	}
 	r = &native_sig_ring[slot % NATIVE_SIGREC_N];
+	memset(r, 0, sizeof(*r));
 	r->pid = (uint32_t)pid;
 	r->sig = signum;
 	r->caller = (uint64_t)(uintptr_t)caller;
 	sender = current_proc();
+	thread = current_thread();
+	r->tid = thread ? thread_tid(thread) : 0;
+	if (signum == SIGABRT && sender == p && thread != NULL &&
+	    __atomic_fetch_add(&native_sb_abort_samples, 1, __ATOMIC_RELAXED) < 4) {
+		arm_saved_state_t *state = get_user_regs(thread);
+		if (state && is_saved_state64(state)) {
+			r->pc = get_saved_state_pc(state);
+			r->lr = get_saved_state_lr(state);
+			r->sp = get_saved_state_sp(state);
+			r->fp = get_saved_state_reg(state, 29);
+			r->x0 = get_saved_state_reg(state, 0);
+			r->x1 = get_saved_state_reg(state, 1);
+			r->x16 = get_saved_state_reg(state, 16);
+			task_t task = proc_task(p);
+			if (task && r->sp != 0) {
+				r->stack_ok =
+				    copyinmap(get_task_map(task), (user_addr_t)r->sp,
+				    r->stack, sizeof(r->stack)) == KERN_SUCCESS;
+			}
+		}
+	}
 	r->sender_pid = sender ? (uint32_t)proc_getpid(sender) : UINT32_MAX;
 	r->reason_ns = reason ? reason->osr_namespace : 0;
 	r->reason_code = reason ? reason->osr_code : 0;
@@ -2727,8 +2790,29 @@
 		printf("NATIVE_SIG: pid=%u sig=%d comm=%.15s sender=%u/%.15s caller=0x%llx ns=%u code=0x%llx flags=0x%llx\n",
 		    r->pid, r->sig, r->comm, r->sender_pid, r->sender_comm,
 		    (unsigned long long)r->caller, r->reason_ns,
 		    (unsigned long long)r->reason_code,
 		    (unsigned long long)r->reason_flags);
+		if (r->sig == SIGABRT && r->pc != 0) {
+			printf("NATIVE_SBABORT: pid=%u tid=%llu caller=0x%llx pc=0x%llx lr=0x%llx sp=0x%llx fp=0x%llx x0=0x%llx x1=0x%llx x16=0x%llx stack=%u\n",
+			    r->pid, (unsigned long long)r->tid,
+			    (unsigned long long)r->caller,
+			    (unsigned long long)r->pc,
+			    (unsigned long long)r->lr,
+			    (unsigned long long)r->sp,
+			    (unsigned long long)r->fp,
+			    (unsigned long long)r->x0,
+			    (unsigned long long)r->x1,
+			    (unsigned long long)r->x16,
+			    r->stack_ok);
+			if (r->stack_ok) {
+				printf("NATIVE_SBABORT_STACK: pid=%u tid=%llu",
+				    r->pid, (unsigned long long)r->tid);
+				for (unsigned i = 0; i < 24; i++) {
+					printf(" %llx", (unsigned long long)r->stack[i]);
+				}
+				printf("\n");
+			}
+		}
 		tail++;
 	}
 	native_sig_tail = tail;
