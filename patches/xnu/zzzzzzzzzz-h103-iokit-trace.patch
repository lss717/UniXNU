@@ -2694,6 +2694,71 @@ is_io_service_match_property_table_bin(
 	return internal_io_service_match_property_table(service, matching, matchingCnt, matches);
 }
 
+extern "C" void proc_selfname(char *, int);
+extern "C" volatile uint32_t native_boot_flags;
+static unsigned native_iokit_match_logs;
+static unsigned native_iokit_open_logs;
+
+static bool
+native_match_name(const char *s, const char *needle)
+{
+	if (!s || !needle) return false;
+	for (unsigned i = 0; s[i]; ++i) {
+		unsigned j = 0;
+		while (needle[j] && s[i + j] == needle[j]) ++j;
+		if (!needle[j]) return true;
+	}
+	return false;
+}
+
+/* H124: log the first calls of every IOKit entry point, not only backboardd's
+ * successful matches. The H103 trace only recorded backboardd's result in
+ * native_boot_flags, so "backboardd never asked" and "the call never reached
+ * the kernel" (bad master port, sandbox denial) were indistinguishable. */
+static void
+native_iokit_log(const char *op, const char *cls, const char *detail, int ok)
+{
+	if (strcmp(op, "match") == 0) {
+		if (native_iokit_match_logs++ >= 24) return;
+	} else if (native_iokit_open_logs++ >= 24) {
+		return;
+	}
+	char comm[17] = {};
+	comm[0] = 0; /* H318: no proc lock under the registry lock */
+	IOLog("NATIVE_IOKIT: op=%s comm=%s cls=%s d=%s ok=%d flags=%x\n",
+	    op, comm, cls ? cls : "-", detail ? detail : "-", ok, native_boot_flags);
+}
+
+static const char *
+native_dict_string(OSDictionary *dict, const char *key)
+{
+	OSString *s = OSDynamicCast(OSString, dict->getObject(key));
+	return s ? s->getCStringNoCopy() : NULL;
+}
+
+static void
+native_match_trace(OSDictionary *dict, bool success)
+{
+	char comm[17] = {};
+	comm[0] = 0; /* H318: no proc lock under the registry lock */
+	bool mobile = false;
+	const char *keys[] = { "IOClass", "IOProviderClass", "IONameMatch" };
+	for (unsigned k = 0; k < sizeof(keys) / sizeof(keys[0]); ++k) {
+		const char *s = native_dict_string(dict, keys[k]);
+		if (s && native_match_name(s, "IOMobile")) mobile = true;
+	}
+	if (strcmp(comm, "backboardd") == 0) {
+		native_boot_flags |= 128;
+		if (mobile) {
+			native_boot_flags &= ~(512U | 1024U);
+			native_boot_flags |= success ? 512U : 1024U;
+			/* H115: the first successful display match is a flush trigger. */
+			if (success) native_boot_flags |= 0x1000U;
+		}
+	}
+	native_iokit_log("match", native_dict_string(dict, "IOClass"),
+	    native_dict_string(dict, "IOProviderClass"), success ? 1 : 0);
+}
 static kern_return_t
