+/* H687: pair enter/return timing with a thread id for the IOKit entry points
+ * backboardd and SpringBoard use for the display, so the log answers "stuck
+ * inside a kernel call" versus "idle between calls".  Focused comms only,
+ * one line per call; the 19.2 MHz always-on timer converts to microseconds.
+ * proc_selfname, thread_tid and mach_absolute_time are declared here because
+ * this file sits above the H124 helpers and pulls none of their headers. */
+extern "C" void proc_selfname(char *, int);
+extern "C" uint64_t thread_tid(thread_t);
+extern "C" thread_t current_thread(void);
+extern "C" uint64_t mach_absolute_time(void);
+
+static void
+native_iotime(const char *op, const char *cls, uint64_t t0, unsigned ret)
+{
+	char comm[17] = {};
+
+	proc_selfname(comm, sizeof(comm));
+	if (strcmp(comm, "backboardd") != 0 && strcmp(comm, "SpringBoard") != 0) {
+		return;
+	}
+	IOLog("NATIVE_IOTIME: op=%s comm=%s cls=%s tid=%llu t=%lluus ret=0x%x\n",
+	    op, comm, cls ? cls : "-",
+	    (unsigned long long) thread_tid(current_thread()),
+	    (unsigned long long) ((mach_absolute_time() - t0) / 19200), ret);
+}
+
+/* H687: record which registry object a focused process pulls out of a match
+ * iterator, and when.  This separates iterator consumption from the match
+ * itself and names the entries behind backboardd's match lines. */
+static unsigned native_iter_logs;
+
+static void
+native_iter_trace(OSObject *obj)
+{
+	char comm[17] = {};
+	IORegistryEntry *entry;
+
+	proc_selfname(comm, sizeof(comm));
+	if (strcmp(comm, "backboardd") != 0 && strcmp(comm, "SpringBoard") != 0) {
+		return;
+	}
+	if (native_iter_logs++ >= 48) {
+		return;
+	}
+	entry = OSDynamicCast(IORegistryEntry, obj);
+	IOLog("NATIVE_IOTIME: op=%s comm=%s cls=%s id=%llu\n",
+	    obj ? "iter" : "iter_none", comm,
+	    obj ? obj->getMetaClass()->getClassName() : "-",
+	    entry ? (unsigned long long) entry->getRegistryEntryID() : 0ULL);
+}
+
