+	    (unsigned long long)st.__sp, (unsigned long long)st.__fp,
+	    (unsigned long long)st.__x[0], (unsigned long long)st.__x[1],
+	    (unsigned long long)st.__x[2], (unsigned long long)st.__x[3]);
+	fp = st.__fp;
+	for (i = 0; i < 16 && fp != 0; i++) {
+		uint64_t frame[2];
+		if (copyin((user_addr_t)fp, frame, sizeof(frame)) != 0) {
+			break;
+		}
+		printf("NATIVE_LAUNCHD_EXIT_FRAME: %d fp=%llx lr=%llx\n", i,
+		    (unsigned long long)fp, (unsigned long long)frame[1]);
+		if (frame[0] <= fp || frame[0] - fp > 0x100000) {
+			break;
+		}
+		fp = frame[0];
+	}
+}
