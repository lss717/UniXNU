+static void
+native_launchd_exit_diag(proc_t p)
+{
+	arm_thread_state64_t st;
+	mach_msg_type_number_t count = ARM_THREAD_STATE64_COUNT;
+	uint64_t fp;
+	int i;
+
+	printf("NATIVE_LAUNCHD_EXIT_DIAG: pid=%d name=%s\n", proc_getpid(p), p->p_name);
+	if (thread_getstatus(current_thread(), ARM_THREAD_STATE64,
+	    (thread_state_t)&st, &count) != KERN_SUCCESS) {
+		printf("NATIVE_LAUNCHD_EXIT_REGS: unavailable\n");
+		return;
+	}
+	printf("NATIVE_LAUNCHD_EXIT_REGS: pc=%llx lr=%llx sp=%llx fp=%llx x0=%llx x1=%llx x2=%llx x3=%llx\n",
