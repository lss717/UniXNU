  * user client (STATUS 398), so the beat sampler never sees them.  Walk the
  * caller's user frame chain at the match return itself to name the code that
  * decides "match, but do not open".  The caller gates process and class. */
+/* H693: a small fixed RAM journal of pre-CDC events (exec/exit, IOKit
+ * match/open, display selector calls, corpse decisions, panics).  The CDC
+ * console attaches ~230-285 s after boot, and both the console ring and the
+ * persistent slot ring only retain a late window, so typed records captured
+ * from the first event are the only way to carry 40-280 s facts across.
+ * Writers are lock-free (one atomic claim per slot) and never print; the
+ * beat sampler exports chunks once CDC is alive. */
+struct native_journal_entry {
+	uint32_t kind;
+	uint32_t ms;
+	uint32_t pid;
+	uint32_t a1;
+	uint32_t a2;
+	uint32_t a3;
+	uint64_t a4;
+	char tag[24];
+};
+
+#define NATIVE_JRNL_MAX 192
+/* kind caps: 1=exec 2=exit 3=iotime 4=panic 5=corpse 6=open 7=selector */
+static struct native_journal_entry native_journal[NATIVE_JRNL_MAX];
+static unsigned native_journal_next;
+static unsigned native_journal_kind_n[8];
+static const unsigned native_journal_kind_cap[8] = {
+	0, 40, 40, 64, 4, 8, 12, 40
+};
+
+void
+native_journal_add(unsigned kind, uint32_t pid, uint32_t a1, uint32_t a2,
+    uint32_t a3, uint64_t a4, const char *tag)
+{
+	if (kind == 0 || kind >= 8) {
+		return;
+	}
+	if (__atomic_fetch_add(&native_journal_kind_n[kind], 1,
+	    __ATOMIC_RELAXED) >= native_journal_kind_cap[kind]) {
+		return;
+	}
+	unsigned i = __atomic_fetch_add(&native_journal_next, 1, __ATOMIC_RELAXED);
+	if (i >= NATIVE_JRNL_MAX) {
+		return;
+	}
+	struct native_journal_entry *e = &native_journal[i];
+	e->kind = (uint32_t)kind;
+	e->ms = (uint32_t) (mach_absolute_time() / 19200ULL);
+	e->pid = pid;
+	e->a1 = a1;
+	e->a2 = a2;
+	e->a3 = a3;
+	e->a4 = a4;
+	e->tag[0] = 0;
+	if (tag != NULL) {
+		strlcpy(e->tag, tag, sizeof (e->tag));
+	}
+}
+
+void
+native_journal_export(void)
+{
+	static unsigned native_journal_cur;
+	extern void native_log_flush_hook(void);
+	unsigned n = __atomic_load_n(&native_journal_next, __ATOMIC_ACQUIRE);
+	if (n > NATIVE_JRNL_MAX) {
+		n = NATIVE_JRNL_MAX;
+	}
+	unsigned emitted = 0;
+	while (native_journal_cur < n && emitted < 20) {
+		struct native_journal_entry *e = &native_journal[native_journal_cur];
+		printf("NATIVE_JRNL: n=%u kind=%u ms=%u pid=%u a1=%x a2=%x a3=%x a4=%llx tag=%s\n",
+		    native_journal_cur, e->kind, e->ms, e->pid, e->a1, e->a2, e->a3,
+		    (unsigned long long) e->a4, e->tag);
+		native_journal_cur++;
+		emitted++;
+		if ((emitted % 8) == 0) {
+			native_log_flush_hook();
+			IOSleep(300);
+		}
+	}
+	native_log_flush_hook();
+}
+
 static unsigned native_dwell_calls;
 
