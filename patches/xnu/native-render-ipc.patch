+/* H675: kernel-side render port observation.
+ *
+ * Bind the CARenderServer receive right once per boot from real
+ * bootstrap traffic seen at ipc_kmsg_send: either the registration
+ * itself (complex message to launchd whose body carries the
+ * "CARenderServer" string and whose port descriptor resolves to the
+ * receiver) or SpringBoard's look-up request followed by the complex
+ * reply from launchd that carries the port.  After the bind, every
+ * message whose resolved destination equals the receiver is counted
+ * by event kind: 'S' = send attempt (reached ipc_kmsg_send with the
+ * port resolved and locked), 'Q'/'D' = actually enqueued or handed
+ * directly to a waiting receiver, 'R' = dequeued.  The sampler issues
+ * one kernel control send (id 'NATC'); when its own enq and deq bump,
+ * the counter pipeline is proven for this boot and a zero
+ * SpringBoard count becomes evidence instead of ambiguity.  Nothing
+ * prints from the IPC hot path; the sampler prints on change plus
+ * every 30th sample. */
+static ipc_port_t native_render_port;
+static unsigned native_render_regpid;
+static unsigned native_render_pending;
+static unsigned native_render_lookpid;
+static unsigned native_render_att;
+static unsigned native_render_sb_att;
+static unsigned native_render_enq;
+static unsigned native_render_deq;
+static unsigned native_render_dead;
+static unsigned native_render_ctrl_state; /* 0 pending, 1 ok, 2 failed, 3 gave up */
+static unsigned native_render_ctrl_try;
+static unsigned native_render_printed_key;
+struct native_render_rec {
+	unsigned from;
+	unsigned id;
+	unsigned size;
+	unsigned ctx;
+};
+static struct native_render_rec native_render_rec[8];
+static unsigned native_render_rec_n;
+static unsigned native_render_rec_drop;
+/* bind/lookup/dead events are recorded here and printed by the
+ * sampler: the note path runs under the destination port lock and must
+ * never print (STATUS 387/388 lock-order rule). */
+static unsigned native_render_evt_bound;
+static const char *native_render_evt_via;
+static unsigned native_render_evt_pid;
+static unsigned long long native_render_evt_port;
+static unsigned native_render_evt_lookup;
+static unsigned native_render_evt_lkp;
+static unsigned native_render_evt_dead;
+static unsigned long long native_render_evt_ctx;
+
+#define NATIVE_RENDER_CTRL_ID 0x4E415443u
+
+static void
+native_render_bind_descriptor(ipc_port_t p, ipc_port_t locked,
+    int binder_pid, const char *via)
+{
+	ipc_port_t recv;
+
+	/* The note fires from ipc_kmsg_send with the destination port
+	 * already locked; re-locking it here would self-deadlock. */
+	if (p == locked) {
+		return;
+	}
+
+	ip_mq_lock(p);
+	if (ip_in_a_space(p)) {
+		recv = p;
+	} else {
+		recv = ip_get_destination(p);
+	}
+	if (!IP_VALID(recv)) {
+		ip_mq_unlock(p);
+		return;
+	}
+	ip_reference(recv);
+	ip_mq_unlock(p);
+	native_render_port = recv;
+	native_render_regpid = (unsigned)binder_pid;
+	native_render_evt_bound = 1;
+	native_render_evt_via = via;
+	native_render_evt_pid = (unsigned)binder_pid;
+	native_render_evt_port = (unsigned long long)(uintptr_t)recv;
+}
+
+static void
+native_render_body_note(ipc_kmsg_t kmsg, ipc_port_t dest_port,
+    int from, int to)
+{
+	if (kmsg == IKM_NULL || kmsg->ikm_type != IKM_TYPE_ALL_INLINED) {
+		return;
+	}
+	mach_msg_header_t *hdr = ikm_header(kmsg);
+	mach_msg_kbase_t *kbase;
+	const char *base = (const char *)hdr;
+	mach_msg_size_t msize = hdr->msgh_size;
+	mach_msg_size_t limit = msize < 512 ? msize : 512;
+
+	unsigned found = 0;
+
+	if (msize < 24) {
+		return;
+	}
+	for (unsigned off = 16; off + 14 <= limit; off++) {
+		if (memcmp(base + off, "CARenderServer", 14) == 0) {
+			found = 1;
+			break;
+		}
+	}
+	if (!found) {
+		return;
+	}
+	if (to == 1 && (hdr->msgh_bits & MACH_MSGH_BITS_COMPLEX) &&
+	    !native_render_port) {
+		kbase = mach_msg_header_to_kbase(hdr);
+		for (mach_msg_size_t i = 0; i < kbase->msgb_dsc_count && i < 64;
+		    i++) {
+			mach_msg_kdescriptor_t *kd = &kbase->msgb_dsc_array[i];
+			if (mach_msg_kdescriptor_type(kd) !=
+			    MACH_MSG_PORT_DESCRIPTOR) {
+				continue;
+			}
+			if (!IP_VALID(kd->kdesc_port.name)) {
+				continue;
+			}
+			native_render_bind_descriptor(
+			    (ipc_port_t)kd->kdesc_port.name, dest_port, from,
+			        "register");
+			return;
+		}
+	} else if (from == native_xpc_pids[0] && to == 1) {
+		native_render_pending = 1;
+		native_render_lookpid = (unsigned)from;
+		native_render_evt_lookup = 1;
+		native_render_evt_lkp = (unsigned)from;
+	} else if (native_render_pending && from == 1 &&
+	    to == (int)native_render_lookpid && !native_render_port &&
+	    (hdr->msgh_bits & MACH_MSGH_BITS_COMPLEX)) {
+		kbase = mach_msg_header_to_kbase(hdr);
+		for (mach_msg_size_t i = 0; i < kbase->msgb_dsc_count && i < 64;
+		    i++) {
+			mach_msg_kdescriptor_t *kd = &kbase->msgb_dsc_array[i];
+			if (mach_msg_kdescriptor_type(kd) !=
+			    MACH_MSG_PORT_DESCRIPTOR) {
+				continue;
+			}
+			if (!IP_VALID(kd->kdesc_port.name)) {
+				continue;
+			}
+			native_render_bind_descriptor(
+			    (ipc_port_t)kd->kdesc_port.name, dest_port, to,
+			        "lookup-reply");
+			native_render_pending = 0;
+			return;
+		}
+	}
+}
+
+static void
+native_render_note(unsigned kind, ipc_kmsg_t kmsg, ipc_port_t port,
+    int from, int to)
+{
+	mach_msg_header_t *hdr;
+
+	(void)to;
+	if (!IP_VALID(port)) {
+		return;
+	}
+	if (!native_render_port) {
+		if (kind == 'S') {
+			native_render_body_note(kmsg, port, from, to);
+		}
+		return;
+	}
+	if (port != native_render_port) {
+		return;
+	}
+	if (!native_render_dead && !ip_active(port)) {
+		native_render_dead = 1;
+		native_render_evt_dead = 1;
+	}
+	hdr = kmsg ? ikm_header(kmsg) : NULL;
+	switch (kind) {
+	case 'S':
+		native_render_att++;
+		if (from == native_xpc_pids[0]) {
+			native_render_sb_att++;
+		}
+		if (hdr != NULL) {
+			if (native_render_rec_n < 8) {
+				unsigned u = native_render_rec_n++;
+				native_render_rec[u].from = (unsigned)from;
+				native_render_rec[u].id = (unsigned)hdr->msgh_id;
+				native_render_rec[u].size = (unsigned)hdr->msgh_size;
+				native_render_rec[u].ctx =
+				    hdr->msgh_size >= 32 ?
+				    (unsigned)((uint32_t *)hdr)[7] : 0;
+			} else {
+				native_render_rec_drop++;
+			}
+		}
+		break;
+	case 'Q':
+	case 'D':
+		native_render_enq++;
+		break;
+	case 'R':
+		native_render_deq++;
+		break;
+	default:
+		break;
+	}
+}
+
+static void
+native_render_control_send(void)
+{
+	mach_msg_header_t ctl;
+	ipc_kmsg_t kmsg = IKM_NULL;
+	mach_msg_return_t mr;
+
+	native_render_ctrl_try++;
+	if (native_render_ctrl_try > 8 || native_render_dead) {
+		native_render_ctrl_state = 3;
+		return;
+	}
+	ctl.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_MOVE_SEND, 0);
+	ctl.msgh_size = sizeof(ctl);
+	ctl.msgh_remote_port = (mach_port_t)native_render_port;
+	ctl.msgh_local_port = MACH_PORT_NULL;
+	ctl.msgh_id = NATIVE_RENDER_CTRL_ID;
+	ip_reference(native_render_port);
+	mr = ipc_kmsg_get_from_kernel(&ctl, sizeof(ctl), MACH_SEND_MSG, &kmsg);
+	if (mr != MACH_MSG_SUCCESS) {
+		ip_release(native_render_port);
+		native_render_ctrl_state = 2;
+		return;
+	}
+	mr = ipc_kmsg_send(kmsg, MACH_SEND_MSG | MACH_SEND_TIMEOUT, 100);
+	if (mr != MACH_MSG_SUCCESS) {
+		ipc_kmsg_destroy(kmsg, IPC_KMSG_DESTROY_ALL);
+		native_render_ctrl_state = 2;
+		return;
+	}
+	native_render_ctrl_state = 1;
+	printf("NATIVE_RENDER: control enqueued id=0x%x\n",
+	    NATIVE_RENDER_CTRL_ID);
+}
+
+static void
+native_render_emit(unsigned sample)
+{
+	unsigned key;
+
+	if (!native_render_port) {
+		return;
+	}
+	if (native_render_ctrl_state == 0) {
+		native_render_control_send();
+	}
+	key = native_render_att ^ (native_render_enq << 10) ^
+	    (native_render_deq << 3) ^ (native_render_ctrl_state << 20) ^
+	    (native_render_sb_att << 6) ^ (native_render_dead << 28);
+	if (key == native_render_printed_key && (sample % 30) != 0) {
+		return;
+	}
+	native_render_printed_key = key;
+	printf("NATIVE_RENDER: sample=%u att=%u sb=%u enq=%u deq=%u ctrl=%u dead=%u reg=%u drop=%u\n",
+	    sample, native_render_att, native_render_sb_att,
+	    native_render_enq, native_render_deq,
+	    native_render_ctrl_state, native_render_dead,
+	    native_render_regpid, native_render_rec_drop);
+	if (native_render_evt_bound) {
+		native_render_evt_bound = 0;
+		printf("NATIVE_RENDER: bound via=%s pid=%u ctx=0x%llx port=0x%llx\n",
+		    native_render_evt_via, native_render_evt_pid,
+		    native_render_evt_ctx, native_render_evt_port);
+	}
+	if (native_render_evt_lookup) {
+		native_render_evt_lookup = 0;
+		printf("NATIVE_RENDER: lookup-request pid=%u\n",
+		    native_render_evt_lkp);
+	}
+	if (native_render_evt_dead) {
+		native_render_evt_dead = 0;
+		printf("NATIVE_RENDER: dead\n");
+	}
+	for (unsigned u = 0; u < native_render_rec_n; u++) {
+		printf("NATIVE_RENDER: sample=%u send from=%u id=0x%x size=%u ctx=0x%x\n",
+		    sample, native_render_rec[u].from,
+		    native_render_rec[u].id, native_render_rec[u].size,
+		    native_render_rec[u].ctx);
+	}
+}
+
+/* H680: second bind path.  The SpringBoard observer reports the
+ * desktop CAContext's render-server connection port (the value
+ * CA::Render::Context::server_port keeps at +0xd0 on 21H461,
+ * verified by disassembly) through the accelerator line channel;
+ * NativeA540AcceleratorProbe calls this when it sees the line.
+ * Resolving the name inside SpringBoard's own space binds the
+ * probe on a port that is observable inside the USB window,
+ * covering the case where the bootstrap registration itself
+ * happened before USB enumerated and its ring region is lost.
+ * First bind wins; a zero port is a verdict, printed once, not a
+ * bind.  Prints here are off the IPC hot path (driver thread). */
+void
+native_render_report_ctxport(int pid, unsigned long long ctxid,
+    unsigned name)
+{
+	ipc_space_t space;
+	ipc_entry_t entry;
+	ipc_port_t port = IP_NULL;
+	struct proc *p;
+	struct task *t;
+
+	if (native_render_port) {
+		return;
+	}
+	if (name == 0) {
+		printf("NATIVE_RENDER: ctxport pid=%d ctx=0x%llx no-port\n",
+		    pid, ctxid);
+		return;
+	}
+	p = proc_find(pid);
+	if (p == NULL) {
+		printf("NATIVE_RENDER: ctxport pid=%d no-proc\n", pid);
+		return;
+	}
+	t = proc_task(p); /* borrowed: proc_find pins it */
+	if (t == TASK_NULL) {
+		proc_rele(p);
+		printf("NATIVE_RENDER: ctxport pid=%d no-task\n", pid);
+		return;
+	}
+	space = t->itk_space;
+	if (space == IS_NULL) {
+		proc_rele(p);
+		printf("NATIVE_RENDER: ctxport pid=%d no-space\n", pid);
+		return;
+	}
+	is_write_lock(space);
+	entry = ipc_entry_lookup(space, (mach_port_name_t) name);
+	if (entry != IE_NULL &&
+	    !(entry->ie_bits & MACH_PORT_TYPE_PORT_SET) &&
+	    (entry->ie_bits & (MACH_PORT_TYPE_SEND |
+	        MACH_PORT_TYPE_SEND_ONCE | MACH_PORT_TYPE_RECEIVE)) != 0 &&
+	    entry->ie_object != IP_NULL) {
+		port = (ipc_port_t) entry->ie_object;
+		ip_reference(port);
+	}
+	is_write_unlock(space);
+	proc_rele(p);
+	if (!IP_VALID(port)) {
+		printf("NATIVE_RENDER: ctxport pid=%d ctx=0x%llx name=0x%x no-entry\n",
+		    pid, ctxid, name);
+		return;
+	}
+	native_render_bind_descriptor(port, IPC_PORT_NULL, pid, "ctxport");
+	if (native_render_port) {
+		native_render_evt_ctx = ctxid;
+		native_xpc_pids[0] = pid;
+	}
+	ip_release(port);
+}
