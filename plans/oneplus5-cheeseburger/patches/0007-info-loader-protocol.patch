@@ -28,6 +28,7 @@ STATIC UINT32   mGopWidth;
 STATIC UINT32   mGopHeight;
 STATIC UINT32   mGopStride;
 STATIC UINT64   mGopBase;
+STATIC BOOLEAN  mLoaderPresent;
 STATIC BOOLEAN  mUserdataFound;
