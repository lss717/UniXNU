@@ -87,7 +87,7 @@ static volatile uint64_t gUfsLastLoops;
 static volatile uint64_t gUfsLastTicks;
 static bool gNopActive;
 
-/* H468: immutable accounting only. Each submitted UTRD gets one ordered
