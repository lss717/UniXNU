+     * H468, which faulted here after the GPT read. */
+    const volatile uint8_t *lbaBytes = q->ucd;
+    gUfsFrozenLba =
+        (static_cast<uint64_t> (lbaBytes[18]) << 24) |
+        (static_cast<uint64_t> (lbaBytes[19]) << 16) |
+        (static_cast<uint64_t> (lbaBytes[20]) << 8) |
+        static_cast<uint64_t> (lbaBytes[21]);
+  }
   gUfsFrozenBytes = bytes;
   gUfsFrozenDir = direction;
   gUfsStartedTicks = mach_absolute_time ();
