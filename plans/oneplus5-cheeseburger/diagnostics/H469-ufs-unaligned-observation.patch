-#define H103_BUILD "H468"
+#define H103_BUILD "H469"
 static uint64_t gH103BootId;
 static volatile int gH103Quiet;
 static volatile uint64_t gH103LastSlotTicks;
@@ -472,7 +472,7 @@ nativeWatchdogThread (void *, wait_result_t)
     if (!gH103StallRecorded && (seconds % 30) == 0) {
       const uint64_t flightMs = gUfsInFlight && gUfsStartedTicks ?
           (mach_absolute_time () - gUfsStartedTicks) / 19200ULL : 0;
-      IOLog ("NATIVE_H468_STATUS: seq=%llu done=%llu timeout=%llu ocs_err=%llu dbto=%llu recover=%llu recovered=%llu flight=%llu age_ms=%llu lba=%llx bytes=%llu dir=%u lock_ok=%llu lock_timeout=%llu lock_wait_ms=%llu lock_wait_max_ms=%llu lock_waiters=%u watchdog_seen=%llu\n",
+      IOLog ("NATIVE_H469_STATUS: seq=%llu done=%llu timeout=%llu ocs_err=%llu dbto=%llu recover=%llu recovered=%llu flight=%llu age_ms=%llu lba=%llx bytes=%llu dir=%u lock_ok=%llu lock_timeout=%llu lock_wait_ms=%llu lock_wait_max_ms=%llu lock_waiters=%u watchdog_seen=%llu\n",
              (unsigned long long) gUfsSubmitSeq,
              (unsigned long long) gUfsDoneCount,
              (unsigned long long) gUfsTimeoutCount,
@@ -2769,11 +2769,19 @@ ufsSubmit (UfsQueue *q, unsigned direction, unsigned bytes,
   gUfsCommands = gUfsCommands + 1;
   gUfsInFlight = 1;
   gUfsSubmitSeq = gUfsSubmitSeq + 1;
-  gUfsFrozenLba = (ucd[0] == 1 &&
-      static_cast<unsigned> (q->ucd[16]) == 0x28) ?
-      (static_cast<uint64_t> (q->ucd[18]) << 24) |
-      (static_cast<uint64_t> (q->ucd[19]) << 16) |
-      (static_cast<uint64_t> (q->ucd[20]) << 8) | q->ucd[21] : 0;
+  gUfsFrozenLba = 0;
+  if (ucd[0] == 1 && static_cast<unsigned> (ucd[16]) == 0x28) {
+    /* The UCD begins and resides on a 4 KiB boundary, so CDB byte 18 is
